nekadrshtantopadana","purobhagah":"अनेकदृष्टान्तोपादानम्","prishthabhagah":"बहूनाम् दृष्टान्तानाम् ग्रहणम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.002","note_id":"LEX.BU249.samanyabahutva","purobhagah":"सामान्यबहुत्वख्यापनार्थम्","prishthabhagah":"सामान्यानि बहूनि इति ज्ञापयितुम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.003","note_id":"LEX.BU249.vilakshana","purobhagah":"विलक्षणाः","prishthabhagah":"विभिन्नलक्षणाः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.004","note_id":"LEX.BU249.cetanacetana","purobhagah":"चेतनाचेतनरूपाः","prishthabhagah":"केचन चेतनरूपाः, केचन अचेतनरूपाः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.005","note_id":"LEX.BU249.samanyavisesha","purobhagah":"सामान्यविशेषाः","prishthabhagah":"सामान्यानि तेषाम् विशेषाः च।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.006","note_id":"LEX.BU249.paramparyagati","purobhagah":"पारम्पर्यगत्या","prishthabhagah":"क्रमेण, लघुसामान्यात् महत्तरसामान्यम् प्रति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.007","note_id":"LEX.BU249.mahasamanya","purobhagah":"महासामान्यम्","prishthabhagah":"सर्वेषाम् सामान्यानाम् आश्रयः, सर्वसामान्यम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.008","note_id":"LEX.BU249.antarbhava","purobhagah":"अन्तर्भावः","prishthabhagah":"अन्तः प्रवेशः, समावेशः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.009","note_id":"LEX.BU249.prajnanaghana","purobhagah":"प्रज्ञानघनः","prishthabhagah":"केवलम् प्रज्ञानम्, प्रज्ञानमात्रम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.010","note_id":"LEX.BU249.shabdatva","purobhagah":"शब्दत्वम्","prishthabhagah":"शब्दसामान्यम्, सर्वेषाम् शब्दानाम् साधारणम् रूपम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.011","note_id":"LEX.BU249.brahmaikatva","purobhagah":"ब्रह्मैकत्वम्","prishthabhagah":"ब्रह्मणः एकत्वम्, अद्वितीयत्वम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.012","note_id":"LEX.BU249.tavat","purobhagah":"तावत्","prishthabhagah":"प्रथमम्, सम्प्रति (उत्पत्तिप्रलययोः विचारः अग्रे)।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.9.RC.013","note_id":"BU.2.4.9.V.004","purobhagah":"वाद्यमानायै","prishthabhagah":"वद् + णिच् → वाद् + इ | ३.१.२६ हेतुमति णिच्; ७.२.११६ उपधायाः वृद्धिः\nवादि + लट् → वादि + यक् + शानच् | ३.२.१२४ लटः शानच्; १.३.१३ कर्मणि आत्मनेपदम्; ३.१.६७ सार्वधातुके यक्\nवाद् + य + आन | ६.४.५१ णेः लोपः\nवाद्य + म् + आन → वाद्यमान | ७.२.८२ आने मुक्\nवाद्यमान + टाप् → वाद्यमाना | ४.१.४ स्त्रियाम् टाप्\nवाद्यमाना + ङे → वाद्यमानायै | ७.३.११३ आपः याट्; ६.१.८८ वृद्धिः\nसिद्धम्: वाद्यमानायै","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"BU.2.4.9.RC.014","note_id":"BU.2.4.9.V.013","purobhagah":"वीणावादस्य","prishthabhagah":"वद् + णिच् → वादि | ३.१.२६ हेतुमति णिच्; ७.२.११६ उपधायाः वृद्धिः\nवादि + घञ् | ३.३.१८ भावे घञ्\nवाद् + अ → वाद | ६.४.५१ णेः लोपः\nवीणा + ङस् + वाद → वीणावाद | २.२.८ षष्ठीतत्पुरुषः; २.४.७१ सुपः लुक्\nवीणावाद + ङस् → वीणावादस्य | ७.१.१२ ङसः स्य-आदेशः\nसिद्धम्: वीणावादस्य","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true}]}}