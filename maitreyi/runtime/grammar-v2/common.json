{"schema":"gv2-common/2","paribhasha":{"स्तरः १ — मूलपदानि":[["पदम्","वाक्ये प्रयुक्तः शब्दः — विभक्त्या वा तिङा वा युक्तः।"],["प्रातिपदिकम्","विभक्तेः पूर्वम् शब्दस्य मूलरूपम् — यथा ‘राम’।"],["धातुः","क्रियायाः मूलम् — यथा ‘भू’, ‘दृश्’।"],["लिङ्गम्","पुंलिङ्गम्, स्त्रीलिङ्गम्, नपुंसकलिङ्गम् इति त्रयम्; विशेषणम् त्रिलिङ्गम्।"],["विभक्तिः","प्रथमा आदयः सप्त, सम्बोधनम् च — शब्दस्य वाक्ये स्थानम् दर्शयति।"],["वचनम्","एकवचनम्, द्विवचनम्, बहुवचनम् — सङ्ख्याम् दर्शयति।"],["लकारः","क्रियायाः कालम् प्रकारम् वा दर्शयति — लट् वर्तमानम्, लिट् परोक्षभूतम् इत्यादि।"],["पुरुषः","प्रथमपुरुषः (सः), मध्यमपुरुषः (त्वम्), उत्तमपुरुषः (अहम्)।"],["कर्तरि / कर्मणि / भावे प्रयोगः","क्रियापदम् कर्तारम् वदति, कर्म वदति, केवलाम् क्रियाम् वा।"],["सुबन्तम्","विभक्त्या युक्तम् नाम सर्वनाम विशेषणम् वा।"],["तिङन्तम्","तिङा युक्तम् क्रियापदम् — यथा ‘भवति’।"],["कृदन्तम्","धातोः जातः शब्दः — यथा ‘द्रष्टव्य’, ‘दर्शन’।"],["तद्धितान्तम्","नाम्नः जातः शब्दः — यथा ‘एकत्व’, ‘गौण’।"],["समस्तपदम्","अनेकानि पदानि मिलित्वा एकम् पदम् — यथा ‘प्रीतिसाधनम्’।"],["अवयवः","समस्तपदस्य भागः।"],["अव्ययम्","यस्य रूपम् न विकरोति — यथा ‘एव’, ‘तत्र’।"],["निपातः","‘च’, ‘एव’, ‘वै’ इत्यादि — अर्थविशेषम् द्योतयति।"],["उपसर्गः","धातोः पूर्वम् योज्यः — ‘प्र’, ‘उप’, ‘नि’ इत्यादि; अर्थम् परिवर्तयति।"],["कर्ता","यः क्रियाम् करोति — ‘कः?’ इति प्रश्नस्य उत्तरम्।"],["कर्म","यत् कर्ता प्राप्तुम् इच्छति — ‘किम्?’ इति प्रश्नस्य उत्तरम्।"],["करणम्","येन क्रिया साध्यते — ‘केन?’ इति प्रश्नस्य उत्तरम्।"],["सम्प्रदानम्","यस्मै दीयते — ‘कस्मै?’ इति प्रश्नस्य उत्तरम्।"],["अपादानम्","यस्मात् अपगच्छति — ‘कस्मात्?’ इति प्रश्नस्य उत्तरम्।"],["अधिकरणम्","क्रियायाः आधारः — ‘कुत्र?’ इति प्रश्नस्य उत्तरम्।"],["सम्बन्धः","द्वयोः पदयोः योगः — षष्ठ्या प्रायः।"],["हेतुः","कारणम् प्रयोजनम् वा — ‘किमर्थम्?’, ‘कुतः?’ इति प्रश्नयोः उत्तरम्।"],["विशेषणम् / विशेष्यम्","विशेषणम् विशेष्यस्य गुणम् वदति; तस्य लिङ्गम् विभक्तिम् वचनम् च अनुसरति।"],["उद्देश्यम् / विधेयम्","यस्य विषये उच्यते तत् उद्देश्यम्; यत् उच्यते तत् विधेयम्।"],["क्रियाविशेषणम्","क्रियायाः प्रकारम् कालम् वा वदति — यथा ‘पूर्वम्’, ‘ततः’।"],["क्रियापदम्","वाक्यस्य मुख्या क्रिया।"],["अध्याहृतम्","वाक्ये न उक्तम्, किन्तु अर्थात् योज्यम् पदम् — [ ] इति कोष्ठके।"],["अन्वयः","पदानाम् अर्थक्रमेण योजना।"],["पदच्छेदः","सन्धिम् विभज्य पदानाम् पृथक्करणम्।"],["सन्धिः","द्वयोः वर्णयोः समीपे विकारः — यथा ‘आत्मा + एव → आत्मैव’।"],["समासः","पदानाम् मेलनम् — विग्रहेण अर्थः स्फुटः भवति।"],["अर्थः / पर्यायः","शब्दस्य बोध्यम्; पर्यायः समानार्थकः शब्दः।"],["लोके / अत्र","लोके — सामान्ये व्यवहारे; अत्र — अस्मिन् शास्त्रे वाक्ये च।"],["अवधारणम्","अन्यस्य निवृत्तिः — ‘एव’ इत्यनेन।"],["समुच्चयः","द्वयोः बहूनाम् वा योजनम् — ‘च’ इत्यनेन।"],["निषेधः","प्रतिषेधः — ‘न’ इत्यनेन।"],["प्रश्नः / उत्तरम्","प्रश्नेन पदस्य स्थानम् ज्ञायते; उत्तरम् वाक्यस्य एव पदम्।"],["पूर्वपक्षः / सिद्धान्तः","पूर्वपक्षः शङ्कितः मतम्; सिद्धान्तः भाष्यकारस्य निर्णयः।"],["उपसंहारः","उक्तस्य अर्थस्य समापनम्।"],["दृष्टान्तः","अर्थस्य स्फुटीकरणाय लोकप्रसिद्धम् उदाहरणम् — यथा ‘रज्ज्वाम् सर्पः’।"],["उद्धरणम्","अन्यस्मात् ग्रन्थात् आनीतम् वाक्यम्।"]],"स्तरः २ — निष्पत्तिपदानि":[["प्रकृतिः / प्रत्ययः","प्रकृतिः मूलम् (धातुः वा प्रातिपदिकम् वा); प्रत्ययः ततः परम् योज्यः अंशः।"],["निष्पत्तिः","प्रकृतेः प्रत्ययात् च पदस्य उत्पत्तिः।"],["विग्रहः","समस्तपदस्य अर्थम् पृथक्पदैः वाक्येन दर्शयति।"],["समासनामानि","तत्पुरुषः, कर्मधारयः, बहुव्रीहिः, द्वन्द्वः, अव्ययीभावः इत्यादीनि — समासस्य प्रकाराः।"],["प्रधानपदम् / अन्यपदार्थः","समासे मुख्यम् पदम्; बहुव्रीहौ मुख्यः अर्थः अन्यः — समासात् बहिः।"],["पूर्वपदम् / उत्तरपदम्","समासस्य प्रथमम् अन्तिमम् च पदम्।"],["कृत्यप्रत्ययः","तव्यत्, अनीयर्, यत् इत्यादयः — ‘कर्तव्यम्, योग्यम्’ इति अर्थे।"],["निष्ठा","क्त, क्तवतु — भूते काले।"],["भावे / कर्तरि / करणे / कर्मणि (प्रत्ययार्थे)","प्रत्ययः किम् वदति — क्रियाम्, कर्तारम्, साधनम्, कर्म वा।"],["मत्वर्थीयः / शैषिकः","मत्वर्थीयः ‘तत् अस्य अस्ति’ इति अर्थे; शैषिकः ‘तत्र भवः’ इत्यादिषु अर्थेषु।"],["तुल्यार्थे / प्राचुर्ये / विकारे","तद्धितानाम् अर्थाः — सादृश्यम्, बाहुल्यम्, विकारः।"],["विभक्त्यर्थः","विभक्तिः अत्र किम् अर्थम् वदति — यथा ‘हेतौ पञ्चमी’।"],["गणः","धातूनाम् दश वर्गाः — भ्वादिः, अदादिः … चुरादिः।"],["परस्मैपदी / आत्मनेपदी / उभयपदी","धातोः तिङ्-प्रत्ययाः कीदृशाः इति।"],["सेट् / अनिट् / वेट्","आर्धधातुके ‘इ’ इति आगमः भवति, न भवति, विकल्पेन भवति।"],["उणादिप्रत्ययः","उणादिसूत्रैः विहिताः प्रत्ययाः — प्रायः रूढशब्देषु।"],["सूत्रम् / वार्तिकम्","पाणिनेः नियमः सूत्रम्; कात्यायनस्य पूरकम् वचनम् वार्तिकम्।"],["योगविभागः","एकस्य सूत्रस्य भागशः पठनम्, अधिकस्य रूपस्य सिद्धये।"],["विकल्पः","द्वे रूपे अपि साधुनी।"],["छान्दसम् / आर्षम्","वेदे ऋषिवचने च दृश्यम् लोके अप्रसिद्धम् रूपम्।"],["सन्धिनामानि","गुणसन्धिः, यण्सन्धिः, विसर्गसन्धिः इत्यादीनि — सन्धेः प्रकाराः।"],["रचनाप्रकारः","भाष्ये पुनः पुनः दृश्यमाना वाक्यरचना — यथा ‘…त्वात्’ हेतुपञ्चमी।"]],"स्तरः ३ — प्रक्रियापदानि":[["आगमः","मध्ये योज्यः वर्णः — यथा ‘अम्’, ‘नुट्’, ‘इट्’।"],["आदेशः","एकस्य स्थाने अन्यः — यथा ‘ङसि → आत्’।"],["लोपः / लुक्","वर्णस्य प्रत्ययस्य वा अदर्शनम्।"],["इत्","प्रत्यये धातौ वा सूचनार्थः वर्णः — उच्चारणे लुप्यते।"],["अङ्गम्","प्रत्ययात् पूर्वः भागः।"],["उपधा","अन्तिमात् वर्णात् पूर्वः वर्णः।"],["टि","अन्तिमः स्वरः ततः परः च भागः।"],["अभ्यासः / द्वित्वम्","धातोः द्विरुक्तौ पूर्वः भागः अभ्यासः।"],["सम्प्रसारणम्","य् व् र् ल् इत्येषाम् स्थाने इ उ ऋ ऌ।"],["गुणः / वृद्धिः","गुणः — अ ए ओ; वृद्धिः — आ ऐ औ।"],["यण् / अयादेशः","इ उ ऋ ऌ → य् व् र् ल्; ए ऐ ओ औ → अय् आय् अव् आव्।"],["रुँ / विसर्गः","पदान्ते सकारः ‘रुँ’ भवति, ततः विसर्गः (ः)।"],["जश्त्वम् / चर्त्वम्","व्यञ्जनस्य मृदुत्वम् (ज ब ग ड द) कठोरत्वम् (च ट त क प) वा।"],["श्चुत्वम् / ष्टुत्वम्","स्, त्-वर्गस्य श्, च-वर्गः; ष्, ट-वर्गः वा।"],["णत्वम् / षत्वम्","न् → ण्; स् → ष्।"],["नुम् / पुक् / इट्","आगमविशेषाः — न्, प्, इ।"],["कित् / ङित् / पित् / णित्","प्रत्ययस्य इत्-वर्णाः — गुणादिकार्यम् निषेधन्ति विदधति वा।"],["सार्वधातुकम् / आर्धधातुकम्","धातोः परे प्रत्ययानाम् द्वौ वर्गौ।"],["शप् / श्यन् / श्नु / श्नम् / उ / श","गणानुसारम् धातोः परः विकरणः।"],["यक्","कर्मणि भावे च विकरणः।"],["सन् / णिच् / यङ्","इच्छायाम्, प्रेरणायाम्, पौनःपुन्ये धातोः परः प्रत्ययः।"],["घि-संज्ञा / नदी-संज्ञा / भ-संज्ञा / पद-संज्ञा","शब्दानाम् अङ्गानाम् च विशेषनामानि — कार्यविशेषाय।"],["सर्वनामस्थानम्","सुँ, औ, जस्, अम्, औट् — एतेषु परेषु विशेषकार्यम्।"],["रूपसिद्धिः","प्रक्रियायाः समाप्तौ सिद्धम् पदम्।"]]},"patterns":{"hetu-pancami":{"name":"‘…त्वात्’ — हेतुपञ्चमी","text":"भाष्ये ‘…त्वात्’ इति पदम् प्रायः कारणम् वदति: ‘अस्मात् कारणात्’। गुणवाचिनः भाववाचिनः च शब्दात् हेतौ पञ्चमी विकल्पेन; पक्षे तृतीया ‘…त्वेन’।","sutras":["⟦2.3.25⟧","⟦2.3.23⟧"]},"hetu-tritiya":{"name":"‘…त्वेन’ — हेतुतृतीया","text":"‘…त्वेन’ इति पदम् अपि कारणम् वदति। हेतौ तृतीया।","sutras":["⟦2.3.23⟧"]},"sati-saptami":{"name":"सति सप्तमी","text":"एकस्याः क्रियायाः सत्ताम् दर्शयित्वा अन्याम् क्रियाम् सूचयति: ‘आत्मनि दृष्टे सर्वम् विदितम्’।","sutras":["⟦2.3.37⟧"]},"tadarthye-chaturthi":{"name":"तादर्थ्ये चतुर्थी","text":"‘किमर्थम्?’ इति प्रश्नस्य उत्तरम् चतुर्थ्या: ‘पत्युः कामाय’ = पत्युः प्रयोजनाय।","sutras":["⟦2.3.13⟧"]},"iti-upavakya":{"name":"इति-उपवाक्यम्","text":"‘इति’ उद्धृतम् वाक्यम् समापयति; तत् सर्वम् एकम् पदम् इव क्रियया युज्यते।","sutras":[]},"yat-tat":{"name":"यत्–तत् सम्बन्धः","text":"‘यत् … तत्’, ‘यदा … तदा’ इति द्वे उपवाक्ये परस्परम् सम्बध्येते।","sutras":[]},"iti-chet-na":{"name":"‘…इति चेत्, न’","text":"शङ्का ‘…इति चेत्’ इति उपस्थाप्यते; ‘न’ इति सिद्धान्तः आरभते।","sutras":[]},"kim-tarhi":{"name":"‘किं तर्हि’","text":"निषेधानन्तरम् ‘किं तर्हि’ इति प्रश्नेन सिद्धान्तः उपस्थाप्यते।","sutras":[]},"eva-avadharana":{"name":"एव-अवधारणम्","text":"‘एव’ यत् पदम् अनुसरति, तस्य एव ग्रहणम्, अन्यस्य निवृत्तिः।","sutras":[]},"krtya-kartari":{"name":"कृत्ये कर्तरि तृतीया/षष्ठी","text":"कृत्यप्रत्ययान्ते (द्रष्टव्यः) कर्म प्रथमायाम्; कर्ता तृतीयायाम् षष्ठ्याम् वा, प्रायः अनुक्तः।","sutras":["⟦2.3.71⟧"]},"krit-karmani-shashthi":{"name":"कृद्योगे कर्मणि षष्ठी","text":"कृदन्तेन योगे कर्म षष्ठ्याम्: ‘आत्मनः दर्शनेन’ = आत्मानम् दृष्ट्वा।","sutras":["⟦2.3.65⟧"]},"ktva-purvakala":{"name":"क्त्वा/ल्यप् — पूर्वकालिकी क्रिया","text":"‘…त्वा’, ‘…य’ इति पदम् पूर्वम् कृताम् क्रियाम् वदति; समानः कर्ता।","sutras":["⟦3.4.21