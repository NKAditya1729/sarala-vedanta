"html","sha256":"108cfd3df2656592a27df8171148bca4c22f23a70f264815def25b34b9af7335","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":257,"target":{"kind":"evidence"}},{"id":"BR_C02_S04_V03","anchor":"BR_C02_S04_V03","kind":"mula","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V03","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"3b416d5ea122f2a9538e983f6cd72a1779ac1b68d8083270381e0a827d260c31","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":93,"target":{"kind":"evidence"}},{"id":"BR_C02_S04_V01_B01","anchor":"BR_C02_S04_V01_B01","kind":"bhashya","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V01_B01","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"1d8da504e8b121869305691ee7462aa506512b5cd837252d8f66a585ffd4062c","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":518,"target":{"kind":"evidence"}},{"id":"BR_C02_S04","anchor":"BR_C02_S04","kind":"heading","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"5800745c4f22529d34a09dd94c1177bb056931c6017464005831a6d1daaa83e5","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":18,"target":{"kind":"evidence"}}],"unit":{"unit_id":"BU.2.4.4","review_cards":[{"id":"BU.2.4.4.CARD.001","lexicon_id":"LEX.BU244.vittasadhya","purobhagah":"वित्तसाध्यम्","prishthabhagah":"वित्तेन निष्पाद्यम् कर्म। अत्र अमृतत्वस्य साधनम् इति शङ्कितम् कर्म मैत्रेय्या अपि निराकृतम्।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.002","lexicon_id":"LEX.BU244.amritatvasadhana.rejected-karma","purobhagah":"अमृतत्वसाधनम्","prishthabhagah":"अमृतत्वस्य साधनम् इति शङ्कितम् वित्तसाध्यम् कर्म। अत्र तस्य साधनत्वम् प्रत्याख्यातम्, सिद्धम् न।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.003","lexicon_id":"LEX.BU244.svabhiprayasampatti","purobhagah":"स्वाभिप्रायसम्पत्तिः","prishthabhagah":"स्वस्य अभिप्रायस्य सिद्धिः। कर्म मुक्तेः हेतुः न इति याज्ञवल्क्यस्य अभिप्रायः भार्याद्वारा अपि सिद्धः।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.004","lexicon_id":"LEX.BU244.chittanukula","purobhagah":"चित्तानुकूलम्","prishthabhagah":"चित्तस्य अनुकूलम्, मनसः प्रियम्। अत्र मैत्रेय्या भाषितम् प्रियम् वचनम् विवक्षितम्।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.005","lexicon_id":"LEX.amritatvasadhanam","purobhagah":"अमृतत्वसाधनम्","prishthabhagah":"अमृतत्वस्य, मोक्षस्य, साधनम् उपायः। अत्र आत्मज्ञानम् अमृतत्वसाधनम्।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.006","lexicon_id":"LEX.BU244.atmajnana","purobhagah":"आत्मज्ञानम्","prishthabhagah":"आत्मनः स्वरूपस्य अवगमः। याज्ञवल्क्यः तत् मैत्रेय्यै कथयितुम् प्रतिजानीते।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.007","lexicon_id":"LEX.BU244.vyakhyana","purobhagah":"व्याख्यानम्","prishthabhagah":"अर्थस्य विवरणम्। अत्र याज्ञवल्क्यः आत्मज्ञानम् व्याचष्टे।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.008","note_id":"BU.2.4.4.V.009","purobhagah":"सती","prishthabhagah":"भवन्ती। [असँ (भुवि)](https://ashtadhyayi.com/dhatu/02.0060) इति अदादिधातोः शतृप्रत्ययान्तम् सत्; स्त्रियां ङीप्, अतः सती। स्त्रीलिङ्गे प्रथमैकवचनम्; सम्बोधितायाः मैत्रेय्याः विशेषणम्। काशिकायाम् प्रथमासमानाधिकरणः सन् इति प्रयोगः अपि स्वीकृतः। अत्र तस्य अनुसरणम् सम्भाव्यते।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.4.CARD.009","note_id":"BU.2.4.4.V.012","purobhagah":"एहि","prishthabhagah":"आगच्छ। आङ्पूर्वः [इण् (गतौ)](https://ashtadhyayi.com/dhatu/02.0040) इति अदादिधातुः; लोटि परस्मैपदे मध्यमपुरुषैकवचनम्। इ + हि इत्यत्र इहि; आ + इहि इत्यत्र गुणेन एहि।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.010","note_id":"BU.2.4.4.V.013","purobhagah":"आस्स्व","prishthabhagah":"उपविश। [आसँ (उपवेशने)](https://ashtadhyayi.com/dhatu/02.0011) इति अदादिधातोः लोटि आत्मनेपदे मध्यमपुरुषैकवचनम्। शपः लुकि आस् + स्व इति रूपम्। सिद्धान्तकौमुद्याम् आस्स्व इति सकारद्वययुक्तम् रूपम् पठितम्; अत्र अपि सः एव पाठः।","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.011","note_id":"BU.2.4.4.V.019","purobhagah":"निदिध्यासस्व","prishthabhagah":"वाक्यानि अर्थतः निश्चयेन ध्यातुम् इच्छ। निपूर्वः [ध्यै (चिन्तायाम्)](https://ashtadhyayi.com/dhatu/01.1056) इति भ्वादिधातुः; इच्छायाम् सन्, ततः लोट्। पाठे आत्मनेपदस्य मध्यमपुरुषैकवचनम् दृश्यते। मूलधातुः परस्मैपदी; लौकिके परस्मैपदे निदिध्यास इति रूपम् अपेक्ष्यते। अत्र आत्मनेपदम् छान्दसः पदव्यत्ययः इति सम्भाव्यते। अग्रिममन्त्रे निदिध्यासितव्यः इत्यस्य निश्चयेन ध्यातव्यः इति अर्थः; अत्र तु भाष्यकारः इच्छाम् अपि दर्शयति। आत्मनेपदस्य सामान्यनियमः अन्येषु त्रिषु रूपेषु दृश्यते। भाषसे इत्यत्र [भाषँ (व्यक्तायां वाचि)](https://ashtadhyayi.com/dhatu/01.0696), आस्स्व इत्यत्र [आसँ (उपवेशने)](https://ashtadhyayi.com/dhatu/02.0011), व्याचक्षाणस्य इत्यत्र [चक्षिङ् (व्यक्तायां वाचि)](https://ashtadhyayi.com/dhatu/02.0007) इति धातवः। आद्यौ अनुदात्तेतौ, तृतीयः ङित्; अतः आत्मनेपदम्। निदिध्यासस्व इत्यत्र तु एतत् निमित्तम् नास्ति।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.4.CARD.012","note_id":"BU.2.4.4.B.SM.001","purobhagah":"वित्तसाध्ये","prishthabhagah":"साध्य — कर्मणि कृत्यः\nवित्तसाध्य — तृतीयातत्पुरुषः","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.013","note_id":"BU.2.4.4.B.SM.002","purobhagah":"अमृतत्वसाधने","prishthabhagah":"मृत — भूते कृदन्तम्\nअमृत — नञ्तत्पुरुषः\nअमृतत्व — भावे तद्धितः\nसाधन — करणे कृदन्तम्\nअमृतत्वसाधन — षष्ठीतत्पुरुषः","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.014","note_id":"BU.2.4.4.B.SM.003","purobhagah":"स्वाभिप्रायसम्पत्तौ","prishthabhagah":"स्वाभिप्राय — षष्ठीतत्पुरुषः\nस्वाभिप्रायसम्पत्ति — षष्ठीतत्पुरुषः","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.015","note_id":"BU.2.4.4.B.SM.005","purobhagah":"अमृतत्वसाधनम्","prishthabhagah":"मृत — भूते कृदन्तम्\nअमृत — नञ्तत्पुरुषः\nअमृतत्व — भावे तद्धितः\nसाधन — करणे कृदन्तम्\nअमृतत्वसाधन — षष्ठीतत्पुरुषः","nishchayah":"निश्चितम्"},{"id":"BU.2.4.4.CARD.016","note_id":"BU.2.4.4.B.SM.006","purobhagah":"आत्मज्ञानम्","prishthabhagah":"ज्ञान — भावे कृदन्तम्\nआत्मज्ञान — षष्ठीतत्पुरुषः","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.4.005","prakarah":"पुनरभ्यासः","purobhagah":"आह","prishthabhagah":"ब्रुवः परस्य लटः तिपः स्थाने णल्, तेन सह ब्रुवः आह् इति आदेशः च विकल्पेन भवतः ([३.४.८४](https://ashtadhyayi.com/sutraani/3/4/84))। आह् + अ → आह।","note_id":"BU.2.4.4.BV.s01.t12","nishchayah":"निश्चितम्"}]}}