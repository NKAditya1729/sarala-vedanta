"html","sha256":"108cfd3df2656592a27df8171148bca4c22f23a70f264815def25b34b9af7335","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":257,"target":{"kind":"evidence"}},{"id":"BR_C02_S04_V03","anchor":"BR_C02_S04_V03","kind":"mula","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V03","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"3b416d5ea122f2a9538e983f6cd72a1779ac1b68d8083270381e0a827d260c31","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":93,"target":{"kind":"evidence"}},{"id":"BR_C02_S04_V01_B01","anchor":"BR_C02_S04_V01_B01","kind":"bhashya","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V01_B01","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"1d8da504e8b121869305691ee7462aa506512b5cd837252d8f66a585ffd4062c","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":518,"target":{"kind":"evidence"}},{"id":"BR_C02_S04","anchor":"BR_C02_S04","kind":"heading","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"5800745c4f22529d34a09dd94c1177bb056931c6017464005831a6d1daaa83e5","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":18,"target":{"kind":"evidence"}}],"unit":{"unit_id":"BU.2.4.4","lexicon_updates":[{"id":"LEX.BU244.vittasadhya","shabdah":"वित्तसाध्यम्","saralah_arthah":"वित्तेन निष्पाद्यम् कर्म। अत्र अमृतत्वस्य साधनम् इति शङ्कितम् कर्म मैत्रेय्या अपि निराकृतम्।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s01","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"वित्तेन साध्यम् कर्म इति टीकाकारस्य विग्रहः। तृतीयातत्पुरुषः; साध्य इत्यत्र [साधँ (संसिद्धौ)](https://ashtadhyayi.com/dhatu/05.0019) इति स्वादिधातोः ण्यत्। अकारान्तम् नपुंसकम्, सप्तम्येकवचनम्। टीकोक्तस्य कर्मणः विशेषणम्; अमृतत्वसाधने प्रत्याख्याते इति सति सप्तमी। करणार्थेन वित्तेन इति तृतीयान्तम् साध्य इति कृदन्तेन समस्यते ([२.१.३२](https://ashtadhyayi.com/sutraani/2/1/32))। हलन्तस्य साधधातोः कृत्यः ण्यत्; कर्मणि साध्य इति ([३.१.१२४](https://ashtadhyayi.com/sutraani/3/1/124))। कर्मणः प्रत्याख्यानक्रियया याज्ञवल्क्यस्य हर्षः लक्ष्यते; सति सप्तमी ([२.३.३७](https://ashtadhyayi.com/sutraani/2/3/37))।","grammar_note_ids":["BU.2.4.4.BV.s01.t06"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s01.t06"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s01","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.001","source_token_ids":["BU.2.4.4.B.s01.t06"]},"later_occurrences":[],"forms":["वित्तसाध्ये"]},{"id":"LEX.BU244.amritatvasadhana.rejected-karma","shabdah":"अमृतत्वसाधनम्","saralah_arthah":"अत्र शङ्कितम् अमृतत्वसाधनम् — वित्तसाध्यम् कर्म; तत् प्रत्याख्यातम्।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s01","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"अमृतत्वस्य साधनम् इति शङ्किते कर्मणि। अमृतत्वस्य साधनम् इति षष्ठीतत्पुरुषः; अमृतस्य भावः अमृतत्वम्। अकारान्तम् नपुंसकम्, सप्तम्येकवचनम्। अत्र कर्म अमृतत्वम् साधयति इति सिद्धान्तः न कथ्यते। अमृतत्वसाधने प्रत्याख्याते इति सति सप्तमी; टीकायाम् शङ्किते इति विशेषणम् — वस्तुतः कर्म अमृतत्वस्य साधनम् न। न मृतम् इति नञ्तत्पुरुषः ([२.२.६](https://ashtadhyayi.com/sutraani/2/2/6))। उत्तरपदे नञः नकारस्य लोपः ([६.३.७३](https://ashtadhyayi.com/sutraani/6/3/73))। अमृतस्य भावे त्वप्रत्ययः ([५.१.११९](https://ashtadhyayi.com/sutraani/5/1/119))। अमृतत्वस्य साधनम् इति षष्ठीतत्पुरुषः ([२.२.८](https://ashtadhyayi.com/sutraani/2/2/8))।","grammar_note_ids":["BU.2.4.4.BV.s01.t07"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s01.t07"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s01","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.002","source_token_ids":["BU.2.4.4.B.s01.t07"]},"later_occurrences":[],"forms":["अमृतत्वसाधने"]},{"id":"LEX.BU244.svabhiprayasampatti","shabdah":"स्वाभिप्रायसम्पत्तिः","saralah_arthah":"स्वस्य अभिप्रायस्य सिद्धिः। कर्म मुक्तेः हेतुः न इति याज्ञवल्क्यस्य अभिप्रायः भार्याद्वारा अपि सिद्धः।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s01","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"स्वस्य अभिप्रायस्य सिद्धौ। स्वस्य अभिप्रायः; तस्य सम्पत्तिः इति क्रमशः षष्ठीतत्पुरुषौ। सम्पत्ति इत्यत्र सम्पूर्वस्य [पदँ (गतौ)](https://ashtadhyayi.com/dhatu/04.0065) इति दिवादिधातोः भावे क्तिन्। दकारस्य चर्त्वेन तकारः भवति। इकारान्तम् स्त्रीलिङ्गम्, सप्तम्येकवचनम्। कर्म मुक्तेः हेतुः न इति स्वाभिप्रायः; भार्यायाः वचनेन अपि सः सिद्धः। स्वाभिप्रायस्य सम्पत्तौ सत्याम् याज्ञवल्क्यः तुष्टः इति टीकायाः अन्वयः। स्वस्य अभिप्रायः इति अन्तः षष्ठीतत्पुरुषः ([२.२.८](https://ashtadhyayi.com/sutraani/2/2/8))। स्व + अभिप्राय इत्यत्र अकारयोः दीर्घः ([६.१.१०१](https://ashtadhyayi.com/sutraani/6/1/101))। सम्पदः भावे क्तिन्; सम्पत्ति इति स्त्रीलिङ्गम् ([३.३.९४](https://ashtadhyayi.com/sutraani/3/3/94))। अभिप्रायस्य सम्पत्तौ सत्याम् इति हर्षस्य अवस्था लक्ष्यते ([२.३.३७](https://ashtadhyayi.com/sutraani/2/3/37))। क्तिनः तकारे परे पदधातोः दकारस्य तकारः ([८.४.५५](https://ashtadhyayi.com/sutraani/8/4/55))।","grammar_note_ids":["BU.2.4.4.BV.s01.t10"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s01.t10"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s01","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":0,"end":120,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.003","source_token_ids":["BU.2.4.4.B.s01.t10"]},"later_occurrences":[],"forms":["स्वाभिप्रायसम्पत्तौ"]},{"id":"LEX.BU244.chittanukula","shabdah":"चित्तानुकूलम्","saralah_arthah":"चित्तस्य अनुकूलम्, मनसः प्रियम्। अत्र मैत्रेय्या भाषितम् प्रियम् वचनम् विवक्षितम्।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s02","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":120,"end":240,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"चित्तस्य अनुकूलम्, मनसः प्रियम् वचनम्। षष्ठीतत्पुरुषः। अकारान्तम् नपुंसकम्, द्वितीयैकवचनम्। प्रियम् इति भाषणकर्मणः अर्थम् दर्शयति। चित्तस्य अनुकूलम् इति षष्ठीतत्पुरुषः ([२.२.८](https://ashtadhyayi.com/sutraani/2/2/8))। चित्त + अनुकूल इत्यत्र अकारयोः आकारः ([६.१.१०१](https://ashtadhyayi.com/sutraani/6/1/101))।","grammar_note_ids":["BU.2.4.4.BV.s02.t19"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s02.t19"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s02","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":120,"end":240,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.004","source_token_ids":["BU.2.4.4.B.s02.t19"]},"later_occurrences":[],"forms":["चित्तानुकूलम्"]},{"id":"LEX.amritatvasadhanam","shabdah":"अमृतत्वसाधनम्","saralah_arthah":"अमृतत्वस्य, मोक्षस्य, साधनम् उपायः। अत्र आत्मज्ञानम् अमृतत्वसाधनम्।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s03","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":240,"end":332,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"अमृतत्वस्य साधनम्; अत्र आत्मज्ञानम् विवक्षितम्। अमृतत्वस्य साधनम् इति षष्ठीतत्पुरुषः। अकारान्तम् नपुंसकम्, प्रथमैकवचनम्। आत्मज्ञानम् एव अमृतत्वस्य साधनम् इति विशेषणम्। न मृतम् इति नञ्तत्पुरुषः ([२.२.६](https://ashtadhyayi.com/sutraani/2/2/6))। उत्तरपदे नञः नकारस्य लोपः ([६.३.७३](https://ashtadhyayi.com/sutraani/6/3/73))। अमृतस्य भावे त्वप्रत्ययः ([५.१.११९](https://ashtadhyayi.com/sutraani/5/1/119))। अमृतत्वस्य साधनम् इति षष्ठीतत्पुरुषः ([२.२.८](https://ashtadhyayi.com/sutraani/2/2/8))।","grammar_note_ids":["BU.2.4.4.BV.s03.t10"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.3","sarve_prayogah":["BU.2.4.4.B.s03.t10"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s03","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":240,"end":332,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.005","source_token_ids":["BU.2.4.4.B.s03.t10"]},"later_occurrences":[],"forms":["अमृतत्वसाधनम्"],"prior_teaching":{"unit_id":"BU.2.4.3","entry_id":"BU.2.4.3.BP.001","lexicon_id":"LEX.amritatvasadhanam","nishchayah":"निश्चितम्"},"context_note":"अत्र आत्मज्ञानम् इति साधनस्य नाम भाष्ये स्पष्टम् उक्तम्।"},{"id":"LEX.BU244.atmajnana","shabdah":"आत्मज्ञानम्","saralah_arthah":"आत्मनः स्वरूपस्य अवगमः। याज्ञवल्क्यः तत् मैत्रेय्यै कथयितुम् प्रतिजानीते।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s03","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":240,"end":332,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"आत्मनः स्वरूपस्य अवगमः। [ज्ञा (अवबोधने)](https://ashtadhyayi.com/dhatu/09.0043) इति क्र्यादिधातोः भावे ल्युट्; ज्ञानम्। आत्मनः ज्ञानम् इति षष्ठीतत्पुरुषः। अकारान्तम् नपुंसकम्, प्रथमैकवचनम्। यत् तव इष्टम् इति यत् इत्यनेन निर्दिष्टम् आत्मज्ञानम्; तत् कथयिष्यामि इति कर्म अध्याह्रियते। आत्मनः ज्ञानम् इति षष्ठीतत्पुरुषः ([२.२.८](https://ashtadhyayi.com/sutraani/2/2/8))। ज्ञाधातोः भावे ल्युट्; ज्ञान इति ([३.३.११५](https://ashtadhyayi.com/sutraani/3/3/115))। ल्युटः यु इत्यस्य अनादेशः ([७.१.१](https://ashtadhyayi.com/sutraani/7/1/1))।","grammar_note_ids":["BU.2.4.4.BV.s03.t11"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s03.t11"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s03","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":240,"end":332,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.006","source_token_ids":["BU.2.4.4.B.s03.t11"]},"later_occurrences":[],"forms":["आत्मज्ञानम्"]},{"id":"LEX.BU244.vyakhyana","shabdah":"व्याख्यानम्","saralah_arthah":"अर्थस्य विवरणम्। अत्र याज्ञवल्क्यः आत्मज्ञानम् व्याचष्टे।","shankara_lakshanam":{"sentence_id":"BU.2.4.4.B.s04","kind":"सन्दर्भः","nishchayah":"निश्चितम्","source_refs":{"text":{"source_id":"BR_C02_S04_V04_B01","start":332,"end":429,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},"vyutpattih":{"text":"अर्थस्य विवरणम्। वि-आङ्पूर्वः [ख्या (प्रकथने)](https://ashtadhyayi.com/dhatu/02.0055) इति अदादिधातुः; भावे ल्युट्। अकारान्तम् नपुंसकम्, द्वितीयैकवचनम्। कुर्वतः इति क्रियायाः कर्म व्याख्यानम्। चक्षिङः ख्याञ् आर्धधातुके भवति ([२.४.५४](https://ashtadhyayi.com/sutraani/2/4/54)); किन्तु अने परे न भवति — असनयोश्च प्रतिषेधो वक्तव्यः (काशिका; यथा विचक्षणः)। अतः व्याख्यानम् इति ख्याधातोः रूपम्। वि-आङ्पूर्वस्य ख्याधातोः भावे ल्युट् ([३.३.११५](https://ashtadhyayi.com/sutraani/3/3/115))। ल्युटः यु इत्यस्य अनादेशः; व्याख्यान इति ([७.१.१](https://ashtadhyayi.com/sutraani/7/1/1))। शत्रन्तस्य कुर्वतः योगे कर्मणः षष्ठी न भवति ([२.३.६९](https://ashtadhyayi.com/sutraani/2/3/69))। अनभिहिते कर्मणि द्वितीया ([२.३.२](https://ashtadhyayi.com/sutraani/2/3/2))।","grammar_note_ids":["BU.2.4.4.BV.s04.t05"],"nishchayah":"निश्चितम्"},"prathama_parichayah":"BU.2.4.4","sarve_prayogah":["BU.2.4.4.B.s04.t05"],"sambaddhah":[],"viparitah":[],"nishchayah":"निश्चितम्","evidence":[{"source":"भाष्यम्","sentence_id":"BU.2.4.4.B.s04","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"BR_C02_S04_V04_B01","start":332,"end":429,"source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V04_B01"}}},{"source":"टीका","id":"AB_C02_P3118","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118","nishchayah":"निश्चितम्","source_refs":{"quote":{"source_id":"AB_C02_P3118","start":0,"end":257,"source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3118"}}}],"first_teaching_occurrence":{"section":"भाष्यपरिचयः","entry_id":"BU.2.4.4.BP.007","source_token_ids":["BU.2.4.4.B.s04.t05"]},"later_occurrences":[],"forms":["व्याख्यानम्"]}]}}