rmalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":1400,"target":{"kind":"evidence"}}],"unit":{"unit_id":"MK.1.V12","review_cards":[{"id":"MK.1.V12.RC.001","note_id":"LEX.MK1V12.amatra","purobhagah":"अमात्रः","prishthabhagah":"मात्रारहितः ओङ्कारः, तुरीयः आत्मा।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V12.RC.002","note_id":"LEX.MK1V12.viveka","purobhagah":"विवेकः","prishthabhagah":"पृथक्करणम्; ‘इयम् रज्जुः, न सर्पः’ इति भेदज्ञानम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V12.RC.003","note_id":"LEX.MK1V12.samnyasin","purobhagah":"संन्यासी","prishthabhagah":"सर्वकर्माणि त्यक्त्वा परिव्राजकः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V12.RC.004","note_id":"MK.1.V12.V.003","purobhagah":"अव्यवहार्यः","prishthabhagah":"वि + अव + हृ + ण्यत् → व्यवहृ + य | ३.१.१२४ ऋहलोर्ण्यत्; ६.१.७७ इको यणचि\nव्यवहार् + य → व्यवहार्य | ७.२.११५ अचो ञ्णिति — वृद्धिः; १.१.५१ उरण् रपरः\nन + व्यवहार्य → अव्यवहार्य | २.२.६ नञ्; ६.३.७३ नलोपो नञः\nअव्यवहार्य + सु → अव्यवहार्यः | ८.२.६६ रुत्वम्; ८.३.१५ विसर्गः\nसिद्धम्: अव्यवहार्यः","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V12.RC.005","note_id":"MK.1.V12.V.011","purobhagah":"संविशति","prishthabhagah":"सम् + विश् + तिप् → सम् + विश् + श + ति | ३.१.७७ तुदादिभ्यः शः\nविश् + अ + ति → विशति | १.२.४ सार्वधातुकम् अपित्; १.१.५ क्ङिति च — गुणनिषेधः\nसम् + विशति → संविशति | ८.३.२३ मोऽनुस्वारः\nसिद्धम्: संविशति","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V12.RC.006","note_id":"MK.1.V12.BV.s05.t12","purobhagah":"उत्थास्यति","prishthabhagah":"ष्ठा → स्था | ६.१.६४ धात्वादेः षः सः\nउत् + स्था + लृट् → उत् + स्था + स्य + ति | ३.३.१३ लृट् शेषे च; ३.१.३३ स्यतासी लृलुटोः\nउत् + थ्था + स्यति | ८.४.६१ उदः स्थास्तम्भोः पूर्वस्य\nउत्थ्थास्यति → उत्थास्यति | ८.४.६५ झरो झरि सवर्णे — लोपः\nसिद्धम्: उत्थास्यति","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V12.RC.007","note_id":"MK.1.V12.BV.s06.t14","purobhagah":"आलम्बनीभवति","prishthabhagah":"आलम्बन + च्वि | ५.४.५० अभूततद्भावे कृभ्वस्तियोगे सम्पद्यकर्तरि च्विः\nआलम्बनी + च्वि | ७.४.३२ अस्य च्वौ — ईत्वम्\nआलम्बनी + भवति → आलम्बनीभवति | ६.१.६७ वेरपृक्तस्य — च्विलोपः; १.४.६१ ऊर्यादिच्विडाचश्च — गतिसंज्ञा; २.२.१८ कुगतिप्रादयः\nसिद्धम्: आलम्बनीभवति","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true}]}}