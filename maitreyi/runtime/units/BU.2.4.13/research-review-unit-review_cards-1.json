,{"id":"BU.2.4.13.RC.007","note_id":"LEX.BU2413.anyatvadarshana","purobhagah":"अन्यत्वदर्शनम्","prishthabhagah":"‘अहम् अन्यः, इदम् अन्यत्’ इति भेददर्शनम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.008","note_id":"LEX.BU2413.hetvabhava","purobhagah":"हेत्वभावः","prishthabhagah":"कारणस्य अभावः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.009","note_id":"LEX.BU2413.asamsarin","purobhagah":"असंसारी","prishthabhagah":"संसाररहितः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.010","note_id":"LEX.BU2413.vinashin","purobhagah":"विनाशी","prishthabhagah":"यस्य नाशः भवति; यस्य नाशः न भवति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.011","note_id":"LEX.BU2413.vacarambhana","purobhagah":"वाचारम्भणम्","prishthabhagah":"वाचा आरभ्यमाणम्, नाममात्रम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.012","note_id":"LEX.BU2412.vikara","purobhagah":"विकारः","prishthabhagah":"कारणस्य अवस्थान्तरम्, कार्यम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.013","note_id":"LEX.BU2413.shrutyantara","purobhagah":"श्रुत्यन्तरम्","prishthabhagah":"अन्या श्रुतिः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.014","note_id":"LEX.BU2413.paryapta","purobhagah":"पर्याप्तम्","prishthabhagah":"अलम्, अन्यूनम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.015","note_id":"LEX.BU2413.viparilopa","purobhagah":"विपरिलोपः","prishthabhagah":"नाशः, सर्वथा लोपः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.13.RC.016","note_id":"BU.2.4.13.V.008","purobhagah":"भगवान्","prishthabhagah":"भग + मतुप् → भग + मत् | ५.२.९४ अस्ति अर्थे मतुप्\nभग + वत् → भगवत् | ८.२.९ मकारस्य वकारः\nभगवत् + सुँ → भगव + न् + त् + स् | ७.१.७० उगितः नुम्\nभगवान्त् + स् | ६.४.१४ उपधादीर्घः\nभगवान्त् | ६.१.६८ अपृक्तस्य सकारस्य लोपः\nभगवान् | ८.२.२३ संयोगान्तस्य लोपः\nसिद्धम्: भगवान्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"BU.2.4.13.RC.017","note_id":"BU.2.4.13.V.009","purobhagah":"अमूमुहत्","prishthabhagah":"मुह् + णिच् → मोहि | ७.३.८६ लघूपधगुणः\nमोहि + लुङ् (त्) → मोहि + चङ् + त् | ३.१.४८ णिश्रिद्रुस्रुभ्यः कर्तरि चङ्\nमोहि + अ + त् → मोह् + अ + त् | ६.४.५१ णेरनिटि\nमोह् → मुह् | ७.४.१ णौ चङ्युपधाया ह्रस्वः\nमुह् → मुमुह् | ६.१.११ चङि; ७.४.६० हलादिः शेषः\nमुमुह् → मूमुह् | ७.४.९३ सन्वद्भावः; ७.४.९४ अभ्यासस्य दीर्घः\nअ + मूमुहत् | ६.४.७१ अडागमः\nसिद्धम्: अमूमुहत्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"BU.2.4.13.RC.018","note_id":"BU.2.4.13.V.022","purobhagah":"मोहम्","prishthabhagah":"मुह् + घञ् → मुह् + अ | ३.३.१८ भावे घञ्; १.३.८ घकारः इत्; १.३.३ ञकारः इत्\nमोह् + अ → मोह | ७.३.८६ लघूपधस्य गुणः\nमोह + अम् → मोहम् | ६.१.१०७ अमि पूर्वरूपम्\nसिद्धम्: मोहम्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true}]}}