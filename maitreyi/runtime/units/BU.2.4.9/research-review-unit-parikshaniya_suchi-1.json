न् ([३.३.९४](https://ashtadhyayi.com/sutraani/3/3/94)); अनुनासिकलोपः ([६.४.३७](https://ashtadhyayi.com/sutraani/6/4/37)) — गति। (समासः द्रष्टव्यः)। तृतीयैकवचनम्; प्रकारे तृतीया (‘तृतीयाविधाने प्रकृत्यादिभ्य उपसंख्यानम्’ इति वार्तिकम्)।","item_id":"BU.2.4.9.BV.s04.t02"},{"path":"/bhashyam/vyakaranam/14/starah1","nishchayah":"सम्भाव्यम्","reason":"सम्भाव्यम्","item_id":"BU.2.4.9.BV.s04.t02"},{"path":"/bhashyam/vyakaranam/14/learner_sutras/0","nishchayah":"सम्भाव्यम्","reason":"गुणवचनब्राह्मणादिभ्यः कर्मणि च","item_id":"5.1.124"},{"path":"/bhashyam/vyakaranam/14/starah2","nishchayah":"सम्भाव्यम्","reason":"सम्भाव्यम्","item_id":"BU.2.4.9.BV.s04.t02"},{"path":"/bhashyam/vyakaranam/14/starah2/sutras/0","nishchayah":"सम्भाव्यम्","reason":"गुणवचनब्राह्मणादिभ्यः कर्मणि च","item_id":"5.1.124"},{"path":"/bhashyam/vyakaranam/23","nishchayah":"सम्भाव्यम्","reason":"उद्धृतस्य वाक्यस्य समाप्तिम् सूचयति। अत्र निपातः; ‘तत् एतत् प्रेयः पुत्रात्’ इति वचनम् अनन्तरेण उपन्यस्तम् इत्यनेन योजयति।","item_id":"BU.2.4.9.BV.s04.t11"},{"path":"/bhashyam/vyakaranam/23/starah1","nishchayah":"सम्भाव्यम्","reason":"सम्भाव्यम्","item_id":"BU.2.4.9.BV.s04.t11"},{"path":"/bhashyam/vyakaranam/31","nishchayah":"सम्भाव्यम्","reason":"अकारान्तः पुंलिङ्गः, पञ्चम्येकवचनम्। सामान्यविशेषयोः अव्यतिरेकात् (समासः द्रष्टव्यः)। पञ्चम्येकवचनम्; हेतौ पञ्चमी (‘विभाषा गुणेऽस्त्रियाम्’ ([२.३.२५](https://ashtadhyayi.com/sutraani/2/3/25)) इति सम्भाव्यते)। अवगन्तुम् शक्यम् इत्यस्य हेतुः।","item_id":"BU.2.4.9.BV.s05.t08"},{"path":"/bhashyam/vyakaranam/31/starah1","nishchayah":"सम्भाव्यम्","reason":"सम्भाव्यम्","item_id":"BU.2.4.9.BV.s05.t08"},{"path":"/bhashyam/vyakaranam/31/learner_sutras/0","nishchayah":"सम्भाव्यम्","reason":"विभाषा गुणेऽस्त्रियाम्","item_id":"2.3.25"},{"path":"/bhashyam/vyakaranam/31/starah2","nishchayah":"सम्भाव्यम्","reason":"सम्भाव्यम्","item_id":"BU.2.4.9.BV.s05.t08"},{"path":"/bhashyam/vyakaranam/31/starah2/sutras/0","nishchayah":"सम्भाव्यम्","reason":"विभाषा गुणेऽस्त्रियाम्","item_id":"2.3.25"},{"path":"/bhashyam/research_proposals/1","nishchayah":"सम्भाव्यम्","reason":"वीणावादः: वीणायाः वादः (वादनम्) इति षष्ठीतत्पुरुषः स्वीकृतः, दुन्दुभ्याघातः (२.४.७) इति क्रियापदेन सादृश्यात्; ‘वीणाम् वादयति इति वीणावादः’ (कर्मण्यण् [३.२.१]) — वादकः — इति अपरः पक्षः, शङ्खध्मः (२.४.८) इति कर्तृपदेन सादृश्यात्। अर्थभेदः अल्पः।","item_id":"BU.2.4.9.B.RP.002"},{"path":"/bhashyam/research_proposals/2","nishchayah":"सम्भाव्यम्","reason":"पारम्पर्यम्: स्वार्थे ष्यञ् ([५.१.१२४] काशिकावार्तिकम्) इति सम्भाव्यते; परम्परायाः भावः इति भावार्थः अपि सम्भवति।","item_id":"BU.2.4.9.B.RP.003"},{"path":"/bhashyam/research_proposals/3","nishchayah":"सम्भाव्यम्","reason":"प्रज्ञानघनः: ‘प्रज्ञानम् एव घनः’ इति कर्मधारयः गृहीतः; २.४.१२ मध्ये ‘विज्ञानघनः’ इति मूलपदम्, तत्र भाष्यकारस्य विवरणम् अनुसरणीयम्।","item_id":"BU.2.4.9.B.RP.004"},{"path":"/bhashyam/research_proposals/6","nishchayah":"परीक्षणीयम्","reason":"अनेके: नञ्समासे अपि एकशब्दस्य सर्वनामत्वम् अनुवर्तते — ‘अनेके’ इति प्रसिद्धम् रूपम्; [१.१.२७] सर्वादिगणस्य विषयः अत्र विचारणीयः।","item_id":"BU.2.4.9.B.RP.007"}]}}