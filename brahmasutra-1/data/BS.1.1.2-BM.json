"t":[["प्रत्यगात्मनस्त्वविषयत्वमुपपादितम्","प्रत्यक्-आत्मनः तु अविषयत्वम् उपपादितम्",0]," ।"]},{"n":3,"k":"text","t":["यथा च ",["सामान्यतो","सामान्यतः",0]," ",["दृष्टमप्यनुमानं","दृष्टम् अपि अनुमानम्",0]," ब्रह्मणि न प्रवर्तते ",["तथोपरिष्टान्निपुणतरमुपपादयिष्यामः","तथा उपरिष्टात् निपुणतरम् उपपादयिष्यामः",0]," ।"]},{"n":4,"k":"text","t":[["उपपादितं","उपपादितम्",0]," ",["चैतदस्माभिर्विस्तरेण","च एतत् अस्माभिः विस्तरेण",0]," न्यायकणिकायाम् ।"]},{"n":5,"k":"text","t":["न च ",["भूतार्थतामात्रेणानुवादतेत्युपरिष्टादुपपादयिष्यामः","भूत-अर्थता-मात्रेण अनुवादता इति उपरिष्टात् उपपादयिष्यामः",0]," ।"]},{"n":6,"k":"text","t":[["तस्मात्सर्वमवदातम्","तस्मात् सर्वम् अवदातम्",0]," ।"]},{"n":7,"k":"text","t":[["श्रुतिश्च","श्रुतिः च",0]," - “",["यतो","यतः",0]," वा”(तै. उ. ३ । १ । १) इति जन्म दर्शयति, “येन जातानि जीवन्ति” इति ",["जीवनं","जीवनम्",0]," स्थितिम् , “",["यत्प्रयन्ति","यत् प्रयन्ति",0],"” इति ",["तत्रैव","तत्र एव",0]," लयम् ।"]}],"ex":[{"from":1,"to":2,"html":"<p>भाष्यम् — «सति हि इन्द्रिय» इत्यादि। इन्द्रियविषयत्वे सति ब्रह्मणा सह कार्यस्य सम्बन्धः गृह्येत। प्रत्यगात्मनः अविषयत्वम् पूर्वम् उपपादितम्।</p>"},{"from":3,"to":6,"html":"<p>सामान्यतोदृष्टम् अनुमानम् अपि ब्रह्मणि न प्रवर्तते। एतत् उपरिष्टात् निपुणतरम् उपपादयिष्यामः। न्यायकणिकायाम् अपि अस्माभिः विस्तरेण उपपादितम्। भूतार्थतामात्रेण अनुवादता न। एतत् अपि उपरिष्टात् उपपादयिष्यामः। अतः सर्वम् अवदातम्।</p>"},{"from":7,"to":7,"html":"<p>श्रुतिः — «यतः वा इमानि भूतानि जायन्ते» इति जन्म दर्शयति। «येन जातानि जीवन्ति» इति जीवनम्, स्थितिम्। «यत् प्रयन्ति अभिसंविशन्ति» इति तत्र एव लयम्।</p>"}]},{"id":"BM_C01_P0204","s":[{"n":1,"k":"pratika","t":["तस्य च ",["निर्णयवाक्यम्","निर्णय-वाक्यम्",0]," ।"]}],"ex":[{"from":1,"to":1,"html":"<p>भाष्यम् — «तस्य च निर्णयवाक्यम्» इति। «तत् विजिज्ञासस्व» इति जिज्ञासायाः निर्णयः अग्रे उक्तः।</p>"}]},{"id":"BM_C01_P0205","s":[{"n":1,"k":"text","t":["अत्र च ",["प्रधानादिसंशये","प्रधान-आदि-संशये",0]," ",["निर्णयवाक्यम्","निर्णय-वाक्यम्",0]," -"]},{"n":2,"k":"pratika","t":[["आनन्दाद्ध्येवेति","आनन