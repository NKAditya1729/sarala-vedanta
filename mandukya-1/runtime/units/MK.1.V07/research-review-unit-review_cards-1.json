s":[{"id":"MK.1.V07.RC.001","note_id":"LEX.MK1V07.shabdapravrittinimitta","purobhagah":"शब्दप्रवृत्तिनिमित्तम्","prishthabhagah":"येन कारणेन शब्दः अर्थे प्रवर्तते — सम्बन्धः, रूढिः, जातिः, क्रिया, गुणः वा।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.002","note_id":"LEX.MK1V07.visheshapratishedha","purobhagah":"विशेषप्रतिषेधः","prishthabhagah":"आत्मनि आरोपितानाम् विशेषाणाम् निषेधः; तेन एव तुरीयम् बोध्यते।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.003","note_id":"LEX.MK1V07.mithyavikalpa","purobhagah":"मिथ्याविकल्पः","prishthabhagah":"सति अधिष्ठाने कल्पितम् अवस्तु, यथा रज्ज्वाम् सर्पः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.004","note_id":"LEX.MK1V07.aspada","purobhagah":"आस्पदम्","prishthabhagah":"कल्पितस्य आश्रयः, अधिष्ठानम्; तत् सत् एव भवति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.005","note_id":"LEX.MK1V07.pramanaphala","purobhagah":"प्रमाणफलम्","prishthabhagah":"प्रमाणस्य फलम्; अत्र अज्ञानस्य आरोपितस्य च निवृत्तिः एव।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.006","note_id":"LEX.MK1V07.anavastha","purobhagah":"अनवस्था","prishthabhagah":"एकस्य सिद्धये अन्यस्य, तस्य अपि अन्यस्य अपेक्षा — अन्तरहितः दोषः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.007","note_id":"LEX.MK1V07.sthanidharma","purobhagah":"स्थानिधर्मः","prishthabhagah":"स्थानिनाम् (विश्वतैजसप्राज्ञानाम्) धर्मः, यथा अन्तःप्रज्ञत्वम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.008","note_id":"LEX.MK1V07.vyabhichara","purobhagah":"व्यभिचारः","prishthabhagah":"कदाचित् भवति, कदाचित् न भवति; सर्वत्र अनुवृत्तेः अभावः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.009","note_id":"LEX.MK1V07.ekatmapratyaya","purobhagah":"एकात्मप्रत्ययः","prishthabhagah":"सर्वासु अवस्थासु ‘अहम्’ इति एकः अनुवर्तमानः आत्मविषयः प्रत्ययः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.010","note_id":"LEX.MK1V07.bhutapurvagati","purobhagah":"भूतपूर्वगतिः","prishthabhagah":"पूर्वम् अविद्यादशायाम् यत् आसीत्, तत् अपेक्ष्य कथनम्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"MK.1.V07.RC.011","note_id":"MK.1.V07.V.010","purobhagah":"प्रज्ञम्","prishthabhagah":"प्र + ज्ञा + क | ३.१.१३५ इगुपधज्ञाप्रीकिरः कः\nप्र + ज्ञा + अ → प्रज्ञ | १.३.८ ककारः इत्; ६.४.६४ आतः लोपः\nप्रज्ञ + सु → प्रज्ञ + अम् | ७.१.२४ अतः अम्\nप्रज्ञ + अम् → प्रज्ञम् | ६.१.१०७ अमि पूर्वः\nसिद्धम्: प्रज्ञम्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V07.RC.012","note_id":"MK.1.V07.V.021","purobhagah":"शान्तम्","prishthabhagah":"शम् + क्त → शम् + त | ३.२.१०२ निष्ठा; ७.२.१५ इडभावः\nशम् + त → शाम् + त | ६.४.१५ उपधादीर्घः\nशाम् + त → शांत → शान्त | ८.३.२४ अनुस्वारः; ८.४.५८ परसवर्णः\nशान्त + सु → शान्तम् | ७.१.२४ अतः अम्; ६.१.१०७ अमि पूर्वः\nसिद्धम्: शान्तम्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V07.RC.013","note_id":"MK.1.V07.V.029","purobhagah":"विज्ञेयः","prishthabhagah":"वि + ज्ञा + यत् → वि + ज्ञा + य | ३.१.९७ अचो यत्; १.३.३ तकारः इत्\nज्ञा + य → ज्ञी + य | ६.४.६५ ईद्यति\nज्ञी + य → ज्ञेय | ७.३.८४ गुणः\nविज्ञेय + सु → विज्ञेयः | ८.२.६६ रुत्वम्; ८.३.१५ विसर्गः\nसिद्धम्: विज्ञेयः","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V07.RC.014","note_id":"MK.1.V07.BV.s02.t08","purobhagah":"निर्दिदिक्षति","prishthabhagah":"निर् + दिश् + सन् → निर् + दिश् + स | ३.१.७ इच्छायाम् सन्; १.२.१० हलन्तात् कित्त्वम्, गुणाभावः\nदिश् + स → दिदिश् + स | ६.१.९ द्वित्वम्; ७.४.६० हलादिः शेषः\nदिदिश् + स → दिदिष् + स → दिदिक् + स | ८.२.३६ षत्वम्; ८.२.४१ कत्वम्\nदिदिक् + स → दिदिक्ष | ८.३.५९ सस्य षत्वम्\nनिर्दिदिक्ष + शप् + तिप् → निर्दिदिक्षति | ३.१.६८ शप्; ६.१.९७ अतो गुणे\nसिद्धम्: निर्दिदिक्षति","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"MK.1.V07.RC.015","note_id":"MK.1.V07.BV.s26.t06","purobhagah":"व्याप्रियते","prishthabhagah":"वि + आ + पृ + लट् → वि + आ + पृ + त | १.३.१२ अनुदात्तङितः आत्मनेपदम्\nपृ + श + त → पृ + अ + त | ३.१.७७ तुदादिभ्यः शः\nपृ + अ → प्रि + अ → प्रिय् + अ | ७.४.२८ रिङ्; ६.४.७७ इयङ्\nत → ते | ३.४.७९ टित आत्मनेपदानाम् टेः एत्वम्\nवि + आ → व्या | ६.१.७७ यण्\nसिद्धम्: व्याप्रियते","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true}]}}