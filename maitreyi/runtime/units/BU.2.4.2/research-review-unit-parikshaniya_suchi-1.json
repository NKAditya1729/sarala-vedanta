","parikshaniya_suchi":[{"id":"BU.2.4.2.Q.0001","path":"/mula/vyakaranam/8/formal_derivation","reason":"भगोः इति सम्बोधनम् — काशिकायाम् [८.३.१] इत्यत्र वार्तिकम् “विभाषा भवद्भगवदघवतामोच्चावस्य” (हे भगोः, हे भगवन्); अथवा “निपातविज्ञानाद् वा सिद्धम्” इति। कः पक्षः अत्र ग्राह्यः इति परीक्ष्यम्।","nishchayah":"परीक्षणीयम्"},{"id":"BU.2.4.2.Q.0005","path":"/bhashyam/vyakaranam/32/internal_lexical_review","reason":"अग्निहोत्रम् इति कर्मनाम अत्र अविभक्तम् गृहीतम्। तस्य अन्तर्व्युत्पत्तेः उणाद्यादिप्रमाणम् अस्मिन् सञ्चये न सिद्धम्; चतुर्थीतत्पुरुषनियमः अनुमानात् न आरोपितः।","nishchayah":"परीक्षणीयम्"},{"id":"BU.2.4.2.Q.0046","path":"/mula/vyakaranam/14","reason":"प्रश्नपक्षे ‘कथम्’ इति ‘किम्’ इत्यनेन योज्यम् इति टीकाकारः (अनु० ३११४); प्रकारप्रश्नः अत्र न युज्यते, यतः वित्तसाध्यस्य कर्मणः अमृतत्वसाधनत्वम् एव न सिद्धम्। अयम् अन्वयः व्याकरणम् च परीक्ष्यम्।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.Q.0047","path":"/mula/vyakaranam","reason":"लिङः सूत्रम् किम्? ‘यदि … पूर्णा स्यात्, तेन अमृता स्याम्’ इति हेतुहेतुमद्भावे [३.३.१५६ हेतुहेतुमतोर्लिङ्]; प्रश्नपक्षे सम्प्रश्ने [३.३.१६१]; सम्भावनायाम् [३.३.१५५] इति अपि पक्षः। एकः निर्णयः अपेक्षितः।","nishchayah":"परीक्षणीयम्","paths":["/mula/vyakaranam","/bhashyam/vyakaranam"]},{"id":"BU.2.4.2.Q.0048","path":"/bhashyam/samasa_cards/3/steps/0","reason":"‘पृथिवी पूर्णा येन तत्’ इति बहुव्रीहिः गृहीतः; उपसर्जनस्य स्त्रीप्रत्ययस्य ह्रस्वः [१.२.४८ गोस्त्रियोरुपसर्जनस्य] इत्यनेन — पूर्णा → पूर्ण। भाष्यस्य ‘पृथिवीपूर्णवित्तसाध्येन’ इति समासे अयम् एव अवयवविभागः वा इति परीक्ष्यम्।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.R016.Q.0006","path":"/bhashyam/vakyavibhagah/0/anvayah/0/adhyahara/2","reason":"भाष्ये पदम् न; अर्थपूरणाय अध्याहृतम् — अन्यः शब्दः अपि योग्यः स्यात्।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.R016.Q.0007","path":"/bhashyam/vakyavibhagah/1/anvayah/0/adhyahara/3","reason":"भाष्ये पदम् न; ‘कथम्","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.R016.Q.0008","path":"/bhashyam/anvayah/0/clauses/0/adhyahara/2","reason":"भाष्ये पदम् न; अर्थपूरणाय अध्याहृतम् — अन्यः शब्दः अपि योग्यः स्यात्।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.R016.Q.0009","path":"/bhashyam/anvayah/1/clauses/0/adhyahara/3","reason":"भाष्ये पदम् न; ‘कथम्","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.Q.0001.starah1","path":"/mula/vyakaranam/8/starah1","reason":"भगोः इति सम्बोधनम् — काशिकायाम् [८.३.१] इत्यत्र वार्तिकम् “विभाषा भवद्भगवदघवतामोच्चावस्य” (हे भगोः, हे भगवन्); अथवा “निपातविज्ञानाद् वा सिद्धम्” इति। कः पक्षः अत्र ग्राह्यः इति परीक्ष्यम्।","nishchayah":"सम्भाव्यम्"},{"id":"BU.2.4.2.R016.Q.0011","path":"/bhashyam/vyakaranam/24/internal_analysis","reason":"कथञ्चन इति एकम् अव्ययम् वा, कथम् + चन इति द्वे वा — उभयथा अर्थः न भिद्यते; पाठविभागः परीक्ष्यः।","nishchayah":"सम्भाव्यम्"}]}}