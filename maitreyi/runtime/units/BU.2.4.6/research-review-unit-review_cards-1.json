"unit_id":"BU.2.4.6","review_cards":[{"id":"BU.2.4.6.RC.001","note_id":"LEX.BU246.nanu","purobhagah":"ननु","prishthabhagah":"आक्षेपे; पूर्वोक्ते शङ्काम् उत्थापयति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.002","note_id":"LEX.BU246.atmavyatirekena","purobhagah":"आत्मव्यतिरेकेण","prishthabhagah":"आत्मानम् विना, आत्मनः भिन्नतया।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.003","note_id":"LEX.BU246.shravayati","purobhagah":"श्रावयति","prishthabhagah":"श्रुतिः उपदिशति, श्रोतुम् प्रेरयति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.004","note_id":"LEX.BU246.brahmanajati","purobhagah":"ब्राह्मणजातिः","prishthabhagah":"ब्राह्मणत्वम् इति सामान्यम्; ‘ब्रह्म’ इति मूलपदस्य अर्थः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.005","note_id":"LEX.BU246.paradadhyat","purobhagah":"परादध्यात्","prishthabhagah":"दूरीकुर्यात्, तिरस्कुर्यात्।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.006","note_id":"LEX.BU246.atmasvarupavyatirekena","purobhagah":"आत्मस्वरूपव्यतिरेकेण","prishthabhagah":"आत्मनः स्वरूपात् भिन्नतया।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.007","note_id":"LEX.BU246.anatmasvarupena","purobhagah":"अनात्मस्वरूपेण","prishthabhagah":"आत्मनः भिन्नस्य रूपेण, अनात्मरूपेण।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.008","note_id":"LEX.BU246.paramatma","purobhagah":"परमात्मा","prishthabhagah":"परमः आत्मा; सर्वेषाम् आत्मा।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.009","note_id":"LEX.BU246.anukrantani","purobhagah":"अनुक्रान्तानि","prishthabhagah":"क्रमेण उक्तानि।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.010","note_id":"LEX.BU246.prakrtah","purobhagah":"प्रकृतः","prishthabhagah":"प्रस्तुतः, पूर्वम् उक्तः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.011","note_id":"LEX.BU246.sthitikale","purobhagah":"स्थितिकाले","prishthabhagah":"सर्वस्य स्थितेः समये, उत्पत्तेः लयात् च मध्ये।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.012","note_id":"LEX.BU246.atmamayam","purobhagah":"आत्ममयम्","prishthabhagah":"आत्मस्वरूपम्; आत्मा एव अत्र प्रस्तुतः।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.013","note_id":"LEX.BU246.agrahanam","purobhagah":"अग्रहणम्","prishthabhagah":"ग्रहणस्य अभावः, न गृह्यते इति।","prakarah":"शब्दः","nishchayah":"सम्भाव्यम्","metadata_only":true},{"id":"BU.2.4.6.RC.014","note_id":"BU.2.4.6.V.003","purobhagah":"परादात्","prishthabhagah":"दा + लुङ् → दा + तिप् | ३.४.७८ लस्य स्थाने तिप्\nदा + च्लि + ति → दा + सिच् + ति | ३.१.४३ लुङि च्लिः; ३.१.४४ च्लेः सिच्\nअ + दा + सिच् + ति | ६.४.७१ लुङि अङ्गस्य अट् आगमः\nअदा + ति | १.१.२० दा इति घुसंज्ञा; २.४.७७ घोः परस्य सिचः लुक्\nअदात् | ३.४.१०० ङित्-लकारस्य इकारस्य लोपः\nपरा + अदात् → परादात् | ६.१.१०१ सवर्णदीर्घः\nसिद्धम्: परादात्","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"BU.2.4.6.RC.015","note_id":"BU.2.4.6.V.008","purobhagah":"वेद","prishthabhagah":"विद् + लट् | ३.२.१२३ वर्तमाने लट्\nविद् + तिप् | ३.४.७८ लस्य स्थाने तिप्\nविद् + शप् + ति → विद् + ति | ३.१.६८ कर्तरि शप्; २.४.७२ अदादिभ्यः शपः लुक्\nविद् + णल् → विद् + अ | ३.४.८३ विदः लटः स्थाने विकल्पेन णल्\nवेद् + अ → वेद | ७.३.८६ लघूपधस्य गुणः\nसिद्धम्: वेद","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true},{"id":"BU.2.4.6.RC.016","note_id":"BU.2.4.6.V.019","purobhagah":"परादुः","prishthabhagah":"दा + लुङ् → दा + झि | ३.४.७८ लस्य स्थाने झि\nअ + दा + सिच् + झि | ३.१.४३ लुङि च्लिः; ३.१.४४ च्लेः सिच्; ६.४.७१ अट् आगमः\nअदा + झि | २.४.७७ घोः परस्य सिचः लुक्\nअदा + उस् | ३.४.११० आकारान्तात् परस्य झेः जुस्\nअदुस् | ६.१.९६ उसि परे आकारस्य पररूपम्\nअदुः | ८.२.६६ सकारस्य रुँ; ८.३.१५ अवसाने विसर्गः\nपरा + अदुः → परादुः | ६.१.१०१ सवर्णदीर्घः\nसिद्धम्: परादुः","prakarah":"प्रक्रिया","nishchayah":"निश्चितम्","metadata_only":true}]}}