् यत् विस्तर-अर्थम्",0]," ",["शास्त्रं","शास्त्रम्",0]," ",["यस्मात्पुरुषविशेषात्सम्भवति","यस्मात् पुरुष-विशेषात् सम्भवति",0]," स -"]},{"n":3,"k":"text","t":[["पुरुषविशेषः","पुरुष-विशेषः",0]]}],"ex":[{"from":1,"to":3,"html":"<p>उक्तम् अर्थम् प्रमाणयति, व्याप्तिम् दर्शयति। भाष्यम् — «यत् यत् विस्तरार्थम् शास्त्रम् यस्मात् पुरुषविशेषात् सम्भवति, सः» इति। सः पुरुषविशेषः।</p>"}]},{"id":"BM_C01_P0214","s":[{"n":1,"k":"pratika","t":[["ततोऽपि","ततः अपि",0]," -"]},{"n":2,"k":"text","t":["शास्त्रात्"]}],"ex":[{"from":1,"to":2,"html":"<p>भाष्यम् — «ततः अपि» इति। ततः शास्त्रात् अपि।</p>"}]},{"id":"BM_C01_P0215","s":[{"n":1,"k":"pratika","t":[["अधिकतरविज्ञानः","अधिकतर-विज्ञानः",0]]},{"n":2,"k":"text","t":["इति योजना ।"]},{"n":3,"k":"text","t":[["अद्यत्वेऽप्यस्मदादिभिर्यत्समीचीनार्थविषयं","अद्यत्वे अपि अस्मत्-आदिभिः यत् समीचीन-अर्थ-विषयम्",0]," ",["शास्त्रं","शास्त्रम्",0]," विरच्यते ",["तत्रास्माकं","तत्र अस्माकम्",0]," ",["वक्तृणां","वक्तृणाम्",0]," ",["वाक्याज्ज्ञानमधिकविषयम्","वाक्यात् ज्ञानम् अधिक-विषयम्",0]," ।"]},{"n":4,"k":"text","t":["नहि ते ",["तेऽसाधारणधर्मा","ते असाधारण-धर्माः",0]," अनुभूयमाना अपि शक्या वक्तुम् ।"]},{"n":5,"k":"text","t":["न ",["खल्विक्षुक्षीरगुडादीनां","खलु इक्षु-क्षीर-गुड-आदीनाम्",0]," ",["मधुररसभेदाः","मधुर-रस-भेदाः",0]," शक्याः ",["सरस्वत्याप्याख्यातुम्","सरस्वत्या अपि आख्यातुम्",0]," ।"]},{"n":6,"k":"text","t":[["विस्तरार्थमपि","विस्तर-अर्थम् अपि",0]," ",["वाक्यं","वाक्यम्",0]," न ",["वक्तृज्ञानेन","वक्तृ-ज्ञानेन",0]," ",["तुल्यविषयमिति","तुल्य-विषयम् इति",0]," ",["कथयितुं","कथयितुम्",0]," ",["विस्तरग्रहणम्","विस्तर-ग्रहणम्",0]," ।"]}],"ex":[{"from":1,"to":2,"html":"<p>भाष्यम् — «अधिकतरविज्ञानः» इति योजना। शास्त्रस्य कर्ता शास्त्रात् अधिकज्ञानः भवति।</p>"},{"from":3,"to":6,"html":"<p>उदाहरणम्। अद्य अपि अस्मदादिभिः समीचीनार्थविषयम् शास्त्रम् विरच्यते। तत्र वक्तॄणाम् अस्माकम् ज्ञानम् वाक्यात् अधिकविषयम्। असाधारणाः धर्माः अनुभूयमानाः अपि वक्तुम् न शक्याः। इक्षुक्षीरगुडादीनाम् मधुररसभेदाः सरस्वत्या अपि आख्यातुम् न शक्याः। विस्तरार्थम् अपि वाक्यम् वक