alization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":95,"target":{"kind":"evidence"}},{"id":"AB_C02_P3133","anchor":"AB_C02_P3133","kind":"tika","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3133","request_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/","transport":"html","sha256":"7451598aaeea571a025946bdec5a1116a5c96512de426d6eb1974ce9de5963ea","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":61,"target":{"kind":"evidence"}},{"id":"BR_C02_S04_V01","anchor":"BR_C02_S04_V01","kind":"mula","source_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/#BR_C02_S04_V01","request_url":"https://advaitasharada.sringeri.net/read/brihadaranyaka-bhashya/2/","transport":"html","sha256":"f51ff92c8e517f178fca491a797a87728836d74a5ff5206c18de85af8a7225e1","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":108,"target":{"kind":"evidence"}}],"unit":{"unit_id":"BU.2.4.5","review_cards":[{"id":"CARD.BU.2.4.5.001","prakarah":"रूपम्","purobhagah":"पत्युः — कथम् इदं रूपम्?","prishthabhagah":"पति-शब्दः समासात् बहिः घिसंज्ञकः न भवति; अतः पतेः इति न भवति।","note_id":"BU.2.4.5.V.007","srotah":"BU.2.4.5.M.007","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.5.002","prakarah":"रूपम्","purobhagah":"द्रष्टव्यः — कथम् इदं रूपम्?","prishthabhagah":"दृश्-धातोः द्रष्टव्य इति रूपे अकारागमः षत्वम् ष्टुत्वम् च शिक्ष्यन्ते।","note_id":"BU.2.4.5.V.147","srotah":"BU.2.4.5.M.147","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.5.003","prakarah":"रूपम्","purobhagah":"मैत्रेयि — कथम् इदं रूपम्?","prishthabhagah":"ईकारान्तस्य स्त्रीशब्दस्य सम्बोधने ह्रस्वः दृश्यते।","note_id":"BU.2.4.5.V.151","srotah":"BU.2.4.5.M.151","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.5.B.001","prakarah":"शब्दः","purobhagah":"वैराग्यम् — अत्र कः अर्थः?","prishthabhagah":"बाह्येषु वस्तुषु आसक्तेः निवृत्तिः वैराग्यम्।","note_id":"LEX.vairagya","srotah":"BU.2.4.5.B.s01.t05","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.002","prakarah":"शब्दः","purobhagah":"गौणी — अत्र कः अर्थः?","prishthabhagah":"आत्मनः प्रयोजनम् आश्रिता अन्यत्र प्रीतिः गौणी। आत्मनि प्रीतिः मुख्या।","note_id":"LEX.gauni","srotah":"BU.2.4.5.B.s09.t03","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.003","prakarah":"शब्दः","purobhagah":"सम्यग्दर्शनम् — अत्र कः अर्थः?","prishthabhagah":"आत्मा ब्रह्म एव इति यथार्थज्ञानम् सम्यग्दर्शनम्।","note_id":"LEX.samyagdarshana","srotah":"BU.2.4.5.B.s15.t06","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.004","prakarah":"शब्दः","purobhagah":"अविद्याप्रत्ययः — अत्र कः अर्थः?","prishthabhagah":"आत्मनः अज्ञानात् जाता मिथ्याबुद्धिः अविद्याप्रत्ययः।","note_id":"LEX.avidyapratyaya","srotah":"BU.2.4.5.B.s16.t08","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.005","prakarah":"शब्दः","purobhagah":"उपमर्दनम् — अत्र कः अर्थः?","prishthabhagah":"अत्र मिथ्याबुद्धेः निवर्तनम् उपमर्दनम्।","note_id":"LEX.upamardana","srotah":"BU.2.4.5.B.s16.t12","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.006","prakarah":"रूपम्","purobhagah":"आचार्यतः — कः प्रत्ययः?","prishthabhagah":"अपादानार्थे पञ्चम्याः तसिप्रत्ययः। तसिल् इति अत्र न कथ्यते।","note_id":"BU.2.4.5.BV.s11.t03","srotah":"BU.2.4.5.B.s11.t03","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.007","prakarah":"वाक्प्रयोगः","purobhagah":"तस्मात् — अस्य प्रयोगस्य कार्यम् किम्?","prishthabhagah":"पूर्वोक्तात् हेतोः निष्कर्षः बोध्यते।","note_id":"VP.tasmat","srotah":"BU.2.4.5.B.s07.t01","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.002","prakarah":"समासः","purobhagah":"जायापतिपुत्रादिभ्यः — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[जाया पति पुत्र] आदि]। जाया पतिः पुत्राः च अन्ये प्रियाः पदार्थाः अपि अत्र गृह्यन्ते।","note_id":"BU.2.4.5.B.SM.002","srotah":"BU.2.4.5.B.s01.t07","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.004","prakarah":"समासः","purobhagah":"प्रसिद्धस्मरणार्थः — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[प्रसिद्ध स्मरण] अर्थ]। वैशब्दः लोके प्रसिद्धम् अर्थम् स्मारयति।","note_id":"BU.2.4.5.B.SM.004","srotah":"BU.2.4.5.B.s02.t05","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.009","prakarah":"समासः","purobhagah":"उक्तानुक्तार्थम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[उक्त [नञ् उक्त]] अर्थ]। सर्वशब्देन पूर्वम् उक्ताः पदार्थाः अनुक्ताः पदार्थाः च गृह्यन्ते।","note_id":"BU.2.4.5.B.SM.009","srotah":"BU.2.4.5.B.s06.t02","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.012","prakarah":"समासः","purobhagah":"आत्मप्रीतिसाधनत्वात् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[आत्मन् प्रीति] साधन]। अन्ये पदार्थाः आत्मनि प्रीतेः साधनानि भवन्ति। तेषु प्रीतिः गौणी भवति।","note_id":"BU.2.4.5.B.SM.012","srotah":"BU.2.4.5.B.s09.t02","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.015","prakarah":"समासः","purobhagah":"श्रवणमनननिदिध्यासनसाधनैः — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[श्रवण मनन निदिध्यासन] साधन]। श्रवणम् मननम् निदिध्यासनम् च साधनानि। तेषाम् अनुष्ठानेन आत्मा ज्ञायते।","note_id":"BU.2.4.5.B.SM.015","srotah":"BU.2.4.5.B.s14.t06","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.017","prakarah":"समासः","purobhagah":"ब्रह्मैकत्वविषयम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[ब्रह्मन् [एक त्व]] विषय]। ब्रह्मणा सह आत्मनः एकत्वम् अत्र ज्ञानस्य विषयः।","note_id":"BU.2.4.5.B.SM.017","srotah":"BU.2.4.5.B.s15.t07","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.019","prakarah":"समासः","purobhagah":"ब्रह्मक्षत्रादि — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[ब्रह्मन् क्षत्र] आदि]। ब्रह्म क्षत्रम् च अन्ये वर्णादयः अपि अत्र गृह्यन्ते।","note_id":"BU.2.4.5.B.SM.019","srotah":"BU.2.4.5.B.s16.t02","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.021","prakarah":"समासः","purobhagah":"वर्णाश्रमादिलक्षणम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[[वर्ण आश्रम] आदि] लक्षण]। वर्णाः आश्रमाः अवस्थाः इत्यादयः अस्य कल्पितस्य रूपाणि।","note_id":"BU.2.4.5.B.SM.021","srotah":"BU.2.4.5.B.s16.t04","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.B.SM.022","prakarah":"समासः","purobhagah":"अविद्याध्यारोपितप्रत्ययविषयम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[[[नञ् विद्या] अध्यारोपित] प्रत्यय] विषय]। अविद्यया आत्मनि यत् कल्पितम्, तस्य मिथ्याज्ञानम् भवति। कल्पितम् वस्तु तस्य ज्ञानस्य विषयः।","note_id":"BU.2.4.5.B.SM.022","srotah":"BU.2.4.5.B.s16.t06","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.023","prakarah":"समासः","purobhagah":"क्रियाकारकफलात्मकम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[क्रिया कारक फल] आत्मन्]। क्रिया कारकम् फलम् च अस्य कल्पितस्य स्वरूपम्।","note_id":"BU.2.4.5.B.SM.023","srotah":"BU.2.4.5.B.s16.t07","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.024","prakarah":"समासः","purobhagah":"अविद्याप्रत्ययविषयम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[[नञ् विद्या] प्रत्यय] विषय]। अविद्यया उत्पन्नायाः बुद्धेः विषयः अत्र उच्यते।","note_id":"BU.2.4.5.B.SM.024","srotah":"BU.2.4.5.B.s16.t08","nishchayah":"परीक्षणीयम्"},{"id":"CARD.BU.2.4.5.B.SM.026","prakarah":"समासः","purobhagah":"तदुपमर्दनार्थम् — अन्तःपदानि क्रमशः विभजत।","prishthabhagah":"[[तद् उपमर्दन] अर्थ]। कल्पितस्य भेदस्य निवृत्तये श्रुतिः आत्मज्ञानम् उपदिशति।","note_id":"BU.2.4.5.B.SM.026","srotah":"BU.2.4.5.B.s16.t12","nishchayah":"सम्भाव्यम्"},{"id":"CARD.BU.2.4.5.R007.LEX.amritatvasadhana","prakarah":"शब्दः","purobhagah":"अमृतत्वसाधनम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"अमृतत्वस्य, मोक्षस्य, साधनम् उपायः। अत्र वैराग्यम् अमृतत्वसाधनम्।","note_id":"LEX.amritatvasadhana","srotah":"LEX.amritatvasadhana","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.amritatvasadhana"},{"id":"CARD.BU.2.4.5.R007.LEX.upadidikshu","prakarah":"शब्दः","purobhagah":"उपदिदिक्षुः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"उपदेष्टुम् इच्छन्। अत्र याज्ञवल्क्यः वैराग्यम् उपदेष्टुम् इच्छति।","note_id":"LEX.upadidikshu","srotah":"LEX.upadidikshu","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.upadidikshu"},{"id":"CARD.BU.2.4.5.R007.LEX.sannyasa","prakarah":"शब्दः","purobhagah":"सन्न्यासः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"जायायाः पुत्राणाम् वित्तस्य च त्यागः। सम्बन्धभाष्ये सः ब्रह्मविद्यायाः अङ्गम् इति उक्तम्।","note_id":"LEX.sannyasa","srotah":"LEX.sannyasa","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.sannyasa"},{"id":"CARD.BU.2.4.5.R007.LEX.prasiddhasmaranartha","prakarah":"शब्दः","purobhagah":"प्रसिद्धस्मरणार्थः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"लोके प्रसिद्धस्य अर्थस्य स्मरणाय प्रयुक्तः। अत्र वैशब्दः तादृशः।","note_id":"LEX.prasiddhasmaranartha","srotah":"LEX.prasiddhasmaranartha","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.prasiddhasmaranartha"},{"id":"CARD.BU.2.4.5.R007.LEX.kimtarhi","prakarah":"शब्दः","purobhagah":"किं तर्हि — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"निषेधात् अनन्तरम् सिद्धान्तपक्षस्य उपस्थापनम्। अत्र आत्मनः प्रयोजनाय प्रियत्वम् वक्ष्यते।","note_id":"LEX.kimtarhi","srotah":"LEX.kimtarhi","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.kimtarhi"},{"id":"CARD.BU.2.4.5.R007.LEX.yathasanne_pritisadhane","prakarah":"शब्दः","purobhagah":"यथासन्ने प्रीतिसाधने — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"यत् यत् समीपतरम् प्रीतेः साधनम्, तस्मिन् तस्मिन्। तेषु पूर्वम् पूर्वम् वचनम् भवति।","note_id":"LEX.yathasanne_pritisadhane","srotah":"LEX.yathasanne_pritisadhane","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.yathasanne_pritisadhane"},{"id":"CARD.BU.2.4.5.R007.LEX.ishtataratva","prakarah":"शब्दः","purobhagah":"इष्टतरत्वात् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"अधिकम् इष्टत्वम्। समीपतरे प्रिये विषये वैराग्यम् अधिकम् इष्यते।","note_id":"LEX.ishtataratva","srotah":"LEX.ishtataratva","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.ishtataratva"},{"id":"CARD.BU.2.4.5.R007.LEX.uktanuktartha","prakarah":"शब्दः","purobhagah":"उक्तानुक्तार्थम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"उक्तानि अनुक्तानि च वस्तूनि ग्रहीतुम् प्रयुक्तम्। सर्वम् इति पदम् तानि सर्वाणि गृह्णाति।","note_id":"LEX.uktanuktartha","srotah":"LEX.uktanuktartha","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.uktanuktartha"},{"id":"CARD.BU.2.4.5.R007.LEX.upanyasta","prakarah":"शब्दः","purobhagah":"उपन्यस्तम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"पूर्वम् संक्षेपेण उक्तम्। अत्र तदेतत्प्रेयः पुत्रात् इति पूर्ववाक्यम् स्मार्यते।","note_id":"LEX.upanyasta","srotah":"LEX.upanyasta","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.upanyasta"},{"id":"CARD.BU.2.4.5.R007.LEX.vrittisthaniya","prakarah":"शब्दः","purobhagah":"वृत्तिस्थानीयम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"वृत्त्या तुल्यम्। पूर्वम् संक्षेपेण उक्तस्य अत्र विस्तरेण व्याख्यानम्।","note_id":"LEX.vrittisthaniya","srotah":"LEX.vrittisthaniya","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.vrittisthaniya"},{"id":"CARD.BU.2.4.5.R007.LEX.prapanchita","prakarah":"शब्दः","purobhagah":"प्रपञ्चितम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"विस्तरेण उक्तम्। पूर्ववाक्यस्य अर्थः अत्र प्रियवस्तूनाम् उदाहरणैः विस्तारितः।","note_id":"LEX.prapanchita","srotah":"LEX.prapanchita","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.prapanchita"},{"id":"CARD.BU.2.4.5.R007.LEX.darshanarha","prakarah":"शब्दः","purobhagah":"दर्शनार्हः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"दर्शनस्य योग्यः। आत्मा ज्ञातव्यः इति अर्थः।","note_id":"LEX.darshanarha","srotah":"LEX.darshanarha","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.darshanarha"},{"id":"CARD.BU.2.4.5.R007.LEX.apadayitavya","prakarah":"शब्दः","purobhagah":"आपादयितव्यः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"प्रापयितव्यः। आत्मा दर्शनस्य विषयः कर्तव्यः इति अर्थः।","note_id":"LEX.apadayitavya","srotah":"LEX.apadayitavya","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.apadayitavya"},{"id":"CARD.BU.2.4.5.R007.LEX.agamatah","prakarah":"शब्दः","purobhagah":"आगमतः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"आगमात्, शास्त्रात्। आचार्यस्य उपदेशेन शास्त्रात् आत्मा श्रोतव्यः।","note_id":"LEX.agamatah","srotah":"LEX.agamatah","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.agamatah"},{"id":"CARD.BU.2.4.5.R007.LEX.tarkatah","prakarah":"शब्दः","purobhagah":"तर्कतः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"तर्केण। श्रुतः अर्थः युक्तिभिः मन्तव्यः।","note_id":"LEX.tarkatah","srotah":"LEX.tarkatah","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.tarkatah"},{"id":"CARD.BU.2.4.5.R007.LEX.nididhyasana","prakarah":"शब्दः","purobhagah":"निदिध्यासनम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"निश्चयेन ध्यानम्। श्रुतस्य मतस्य च अर्थस्य दृढतया चिन्तनम्।","note_id":"LEX.nididhyasana","srotah":"LEX.nididhyasana","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.nididhyasana"},{"id":"CARD.BU.2.4.5.R007.LEX.nirvartita","prakarah":"शब्दः","purobhagah":"निर्वर्तितैः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"यथाविधि अनुष्ठितैः। श्रवणम् मननम् निदिध्यासनम् च कृतानि इति अर्थः।","note_id":"LEX.nirvartita","srotah":"LEX.nirvartita","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.nirvartita"},{"id":"CARD.BU.2.4.5.R007.LEX.ekatvam_upagatani","prakarah":"शब्दः","purobhagah":"एकत्वम् उपगतानि — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"अङ्गाङ्गिभावेन मिलितानि। प्रधानस्य श्रवणस्य सहायकत्वेन मननम् निदिध्यासनम् च समुच्चिते।","note_id":"LEX.ekatvam_upagatani","srotah":"LEX.ekatvam_upagatani","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.ekatvam_upagatani"},{"id":"CARD.BU.2.4.5.R007.LEX.brahmaikatvavishaya","prakarah":"शब्दः","purobhagah":"ब्रह्मैकत्वविषयम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"ब्रह्मणा एकत्वम् यस्य ज्ञानस्य विषयः, तत्। अत्र सम्यग्दर्शनस्य विषयः आत्मनः ब्रह्मणा एकत्वम्।","note_id":"LEX.brahmaikatvavishaya","srotah":"LEX.brahmaikatvavishaya","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.brahmaikatvavishaya"},{"id":"CARD.BU.2.4.5.R007.LEX.prasidati","prakarah":"शब्दः","purobhagah":"प्रसीदति — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"सम्यक् उदेति। प्रतिबन्धेषु निवृत्तेषु तत्त्वज्ञानम् फलपर्यन्तम् सिध्यति।","note_id":"LEX.prasidati","srotah":"LEX.prasidati","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.prasidati"},{"id":"CARD.BU.2.4.5.R007.LEX.shravanamatrena","prakarah":"शब्दः","purobhagah":"श्रवणमात्रेण — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"केवलेन श्रवणेन। मननस्य निदिध्यासनस्य च अभावे केवलम् श्रवणम् अत्र विवक्षितम्।","note_id":"LEX.shravanamatrena","srotah":"LEX.shravanamatrena","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.shravanamatrena"},{"id":"CARD.BU.2.4.5.R007.LEX.karmanimitta","prakarah":"शब्दः","purobhagah":"कर्मनिमित्तम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"कर्मणः निमित्तम्। ब्राह्मणत्वादि जातिः कर्माधिकारस्य निमित्तम् इति अत्र विवक्षा।","note_id":"LEX.karmanimitta","srotah":"LEX.karmanimitta","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.karmanimitta"},{"id":"CARD.BU.2.4.5.R007.LEX.varnashramadilakshana","prakarah":"शब्दः","purobhagah":"वर्णाश्रमादिलक्षणम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"वर्णाः आश्रमाः च यस्य भेदस्य रूपाणि, तत्। ब्राह्मणत्वादयः आश्रमभेदाः च अत्र गृह्यन्ते।","note_id":"LEX.varnashramadilakshana","srotah":"LEX.varnashramadilakshana","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.varnashramadilakshana"},{"id":"CARD.BU.2.4.5.R007.LEX.avidyadhyaropitapratyayavishaya","prakarah":"शब्दः","purobhagah":"अविद्याध्यारोपितप्रत्ययविषयम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"अविद्यया आत्मनि आरोपितम् ब्रह्मक्षत्रादि मिथ्याज्ञानस्य विषयः। आनन्दगिरिः एतत् एव सम्बन्धम् दर्शयति।","note_id":"LEX.avidyadhyaropitapratyayavishaya","srotah":"LEX.avidyadhyaropitapratyayavishaya","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.avidyadhyaropitapratyayavishaya"},{"id":"CARD.BU.2.4.5.R007.LEX.kriyakarakaphalatmaka","prakarah":"शब्दः","purobhagah":"क्रियाकारकफलात्मकम् — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"क्रिया, तस्याः साधकानि कारकाणि, फलम् च अत्र गृह्यन्ते। ब्रह्मक्षत्रादि एतैः रूपैः अविद्याविषये व्यवह्रियते।","note_id":"LEX.kriyakarakaphalatmaka","srotah":"LEX.kriyakarakaphalatmaka","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.kriyakarakaphalatmaka"},{"id":"CARD.BU.2.4.5.R007.LEX.rajjvam_sarpapratyaya","prakarah":"शब्दः","purobhagah":"रज्ज्वाम् इव सर्पप्रत्ययः — अस्मिन् भाष्ये कः अर्थः?","prishthabhagah":"रज्जौ सर्पः इति मिथ्याबुद्धिः यथा भवति, तथा अत्र अपि मिथ्याज्ञानम्। रज्जौ सर्पः नास्ति; आत्मनि अपि कल्पितः भेदः परमार्थतः नास्ति।","note_id":"LEX.rajjvam_sarpapratyaya","srotah":"LEX.rajjvam_sarpapratyaya","nishchayah":"सम्भाव्यम्","lexicon_id":"LEX.rajjvam_sarpapratyaya"},{"id":"CARD.BU.2.4.5.R007.VP.tvat","prakarah":"वाक्प्रयोगः","purobhagah":"…त्वात् इति प्रयोगेण भाष्यकारः किम् बोधयति?","prishthabhagah":"हेतुं वदति — यस्मात् … भवति इति अर्थः।","note_id":"VP.tvat","srotah":"VP.tvat","nishchayah":"निश्चितम्","expression_id":"VP.tvat"},{"id":"CARD.BU.2.4.5.R007.VP.kim-tarhi","prakarah":"वाक्प्रयोगः","purobhagah":"किं तर्हि इति प्रयोगेण भाष्यकारः किम् बोधयति?","prishthabhagah":"निषेधस्य अनन्तरं यथार्थं पक्षं प्रस्तौति।","note_id":"VP.kim-tarhi","srotah":"VP.kim-tarhi","nishchayah":"निश्चितम्","expression_id":"VP.kim-tarhi"},{"id":"CARD.BU.2.4.5.R007.VP.ityadi","prakarah":"वाक्प्रयोगः","purobhagah":"इत्यादि समानम् अन्यत् इति प्रयोगेण भाष्यकारः किम् बोधयति?","prishthabhagah":"पूर्वोक्तस्य समानानि अन्यानि वाक्यानि संक्षेपेण निर्दिशति।","note_id":"VP.ityadi","srotah":"VP.ityadi","nishchayah":"निश्चितम्","expression_id":"VP.ityadi"},{"id":"CARD.BU.2.4.5.R007.VP.aha","prakarah":"वाक्प्रयोगः","purobhagah":"…आह इति प्रयोगेण भाष्यकारः किम् बोधयति?","prishthabhagah":"श्रुतेः अग्रिमं वचनम् आरभते (अवतरणिका)।","note_id":"VP.aha","srotah":"VP.aha","nishchayah":"निश्चितम्","expression_id":"VP.aha"},{"id":"CARD.BU.2.4.5.R007.V.003","prakarah":"रूपम्","purobhagah":"उवाच — रूपप्रक्रिया का?","prishthabhagah":"वच् + लिट्; वच् + तिप्; वच् + णल्; वच् वच् + अ; उअच् वच् + अ; उच् वच् + अ; उ वच् + अ; उ वाच् + अ → उवाच।","note_id":"BU.2.4.5.V.003","srotah":"BU.2.4.5.V.003","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.5.R007.V.150","prakarah":"रूपम्","purobhagah":"निदिध्यासितव्यः — रूपप्रक्रिया का? भाष्ये अर्थः कः?","prishthabhagah":"नि + ध्यै; नि + ध्या + सन्; नि + ध्या + स; नि + ध्या-ध्यास; नि + धा-ध्यास; नि + ध-ध्यास; नि + धि-ध्यास; नि + दि-ध्यास → निदिध्यास; निदिध्यास; निदिध्यास + तव्यत्; निदिध्यास + इ + तव्य; निदिध्यास् + इ + तव्य → निदिध्यासितव्य। रूपतः सन्नन्तम्; भाष्यकारः निश्चयेन ध्यातव्यः इति व्याचष्टे।","note_id":"BU.2.4.5.V.150","srotah":"BU.2.4.5.V.150","nishchayah":"निश्चितम्"}]}}