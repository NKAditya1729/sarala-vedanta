/","transport":"html","sha256":"c2dbeae278a2295cda3cc42f869e13f72bf005f01071cad528eeb99921544d61","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":575,"target":{"kind":"bhashya","bhashya_id":"BR_C02_S04_V02_B01"}},{"id":"AB_C02_P3116","anchor":"AB_C02_P3116","kind":"tika","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3116","request_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/","transport":"html","sha256":"97026d99557d38209d6f738478640984809eefdee98baad5dafe0ef7634a76e6","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":74,"target":{"kind":"evidence"}},{"id":"AB_C02_P3113","anchor":"AB_C02_P3113","kind":"tika","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3113","request_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/","transport":"html","sha256":"cac9ed928b8dc0a2ab62561e6ccba3fe6f51aaf1659a6aa81d31327d21bda7fe","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":140,"target":{"kind":"evidence"}},{"id":"AB_C02_P3114","anchor":"AB_C02_P3114","kind":"tika","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3114","request_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/","transport":"html","sha256":"8fa8a8787e285ec068a637704ef9c33c044a92cf77f96a3b8a3cc6c7d4caf289","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":220,"target":{"kind":"evidence"}},{"id":"AB_C02_P3115","anchor":"AB_C02_P3115","kind":"tika","source_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/#AB_C02_P3115","request_url":"https://advaitasharada.sringeri.net/read/anandagiri-brha/2-4/","transport":"html","sha256":"8bcf4a2784c6e99be692b8ea7711dd3afaaf2924f2331fe562864c7c40a924b1","normalization":"remove-U+00AD-only","range_encoding":"utf16","length_utf16":90,"target":{"kind":"evidence"}}],"unit":{"unit_id":"BU.2.4.2","review_cards":[{"id":"CARD.BU.2.4.2.001","prakarah":"पुनरभ्यासः","purobhagah":"वितर्कः","prishthabhagah":"सम्भावितस्य विषयस्य फलम् प्रति विचारः।","note_id":"LEX.vitarka","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.002","prakarah":"पुनरभ्यासः","purobhagah":"आक्षेपार्थः","prishthabhagah":"असम्भवम् सूचयति यः शब्दः सः आक्षेपार्थः।","note_id":"LEX.aksheparthah","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.003","prakarah":"पुनरभ्यासः","purobhagah":"प्रश्नार्थः","prishthabhagah":"ज्ञातुम् इच्छाम् सूचयति यः शब्दः सः प्रश्नार्थः।","note_id":"LEX.prashnarthah","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.004","prakarah":"पुनरभ्यासः","purobhagah":"व्यवहितः","prishthabhagah":"मध्ये अन्यत् स्थितम् इति अतः पृथक्कृतः। अत्र मध्ये अन्यानि पदानि सन्ति।","note_id":"LEX.vyavahitam","nishchayah":"निश्चितम्","shabdah":"व्यवहितम्","definition":"दूरे स्थितम्, अन्यैः वचनैः व्यवहितम्। अत्र अग्रिमे मन्त्रे ‘किमहं तेन’ इत्यत्र स्थितः किंशब्दः।"},{"id":"CARD.BU.2.4.2.005","prakarah":"पुनरभ्यासः","purobhagah":"अनुमोदनम्","prishthabhagah":"अन्येन उक्तस्य युक्तत्वम् आदरेण अङ्गीकरणम्।","note_id":"LEX.anumodanam","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.006","prakarah":"पुनरभ्यासः","purobhagah":"अमृतत्वम्","prishthabhagah":"मरणरहितत्वम्; अत्र मोक्षः।","note_id":"LEX.amritatvam","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.007","prakarah":"पुनरभ्यासः","purobhagah":"वित्तेन","prishthabhagah":"धनेन। [विदॢँ (लाभे)](https://ashtadhyayi.com/dhatu/6.168) इति धातोः धनार्थे वित्त इति क्तान्तम्। अकारान्तम् नपुंसकलिङ्गम्, तृतीया एकवचनम्। पूर्णा इत्यत्र येन पूर्णा सा भवति तत् दर्शयति। [३.२.१०२ निष्ठा](https://ashtadhyayi.com/sutraani/3/2/102) — भूते निष्ठाप्रत्ययः क्तः। [८.२.५८ वित्तो भोगप्रत्यययोः](https://ashtadhyayi.com/sutraani/8/2/58) — लाभार्थकविदेः धनार्थे वित्त इति क्तस्य नत्वाभावः निपात्यते।","note_id":"BU.2.4.2.V.012","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.008","prakarah":"पुनरभ्यासः","purobhagah":"स्याम्","prishthabhagah":"अहम् भवेयम् इति सम्भावना। [असँ (भुवि)](https://ashtadhyayi.com/dhatu/2.60) इति धातोः विधिलिङ्लकारे परस्मैपदम्, उत्तमपुरुषः एकवचनम्। अध्याहृतस्य कर्तुः क्रिया। [३.३.१५६ हेतुहेतुमतोर्लिङ्](https://ashtadhyayi.com/sutraani/3/3/156) — हेतौ हेतुमति च लिङ्। प्रश्नपक्षे सम्प्रश्ने लिङ् ([३.३.१६१](https://ashtadhyayi.com/sutraani/3/3/161)) इति अपरः पक्षः। [६.४.१११ श्नसोरल्लोपः](https://ashtadhyayi.com/sutraani/6/4/111) — ङिति सार्वधातुके अस्तेः अकारलोपः; स्यात् इत्यादिरूपाणि।","note_id":"BU.2.4.2.V.018","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.009","prakarah":"पुनरभ्यासः","purobhagah":"पृथिवीपूर्णवित्तसाध्येन","prishthabhagah":"सम्पूर्णपृथिवीगतधनेन अनुष्ठेयेन।","note_id":"BU.2.4.2.B.SM.004","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.010","prakarah":"पुनरभ्यासः","purobhagah":"सुखोपायभोगसम्पन्नम्","prishthabhagah":"सुखसाधनैः भोगैः च युक्तम्।","note_id":"BU.2.4.2.B.SM.009","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.R011.BP.007","prakarah":"पुनरभ्यासः","purobhagah":"किं तर्हि","prishthabhagah":"पूर्वम् निषिद्धे पक्षे ‘अन्यत् किम् भवति?’ इति प्रश्नः; ततः सत्यः पक्षः उच्यते।","note_id":"LEX.kimtarhi.pakshaprasnah","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.R011.BP.008","prakarah":"पुनरभ्यासः","purobhagah":"वित्तसाध्यम् कर्म","prishthabhagah":"धनेन अनुष्ठेयम् अग्निहोत्रादि कर्म; अत्र ‘वित्तेन’ इति पदस्य अर्थः (भाष्यम्)।","note_id":"LEX.vittasadhyam.karma","nishchayah":"निश्चितम्"},{"id":"CARD.BU.2.4.2.R011.BHAGOH","prakarah":"पुनरभ्यासः","purobhagah":"भगोः","prishthabhagah":"भगवत् + सुँ [२.३.४९ — सम्बुद्धिः] → भगवन्त् + स् [७.१.७० — नुम्] → भगवन्त् [६.१.६८ — सुलोपः] → भगवन् [८.२.२३ — संयोगान्तलोपः] → भगोर् [वार्त्तिकम् — नकारस्य रुः, अवस्य ओकारः] → भगोः [८.३.१५ — विसर्गः] इति रूपम् सिद्ध्यति।","note_id":"BU.2.4.2.V.009","nishchayah":"निश्चितम्"}]}}